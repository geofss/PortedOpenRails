            }).Where(path => path is not null).Cast<RoutePathDefinition>().ToArray();
        serviceRouteBindings = ServiceRouteBindingResolver.Resolve(
            loadedServices, loadedRoutePaths, consistCatalog?.Consists ?? Array.Empty<ConsistMetadata>());
        selectedExploreStart = ExploreStartChoices.FirstOrDefault();
        selectedExplorePathId = ExploreDestinationChoices.FirstOrDefault()?.PathId;
        errorMessage = null;
        await BuildRouteNetworkAsync(route);
