@page "/"
@using OpenRails.Web.Content
@using OpenRails.Web.Parsing
@using OpenRails.Web.Simulation
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<main class="shell">
    <header class="or-mainform-heading">
        <h1>Open Rails</h1>
        <span>Desktop browser edition</span>
    </header>
    <section class="or-mainform-workspace" aria-label="Open Rails main menu">
        <aside class="or-mainform-selection">
            <div class="or-mainform-group">
                <h2>Installation profile</h2>
                <label for="or-profile">Profile</label>
                <select id="or-profile" disabled>
                    <option>Browser content profile</option>
                </select>
                <p class="hint">Browser storage is the active content root. Imported packages are managed below.</p>
            </div>
            <div class="or-mainform-group">
                <h2>Route</h2>
                <label for="or-main-route">Selected route</label>
                <select id="or-main-route" value="@SelectedRouteIndex" @onchange="SelectRouteFromMenu" disabled="@(isLoading || routeChoices.Count == 0)">
                    <option value="-1">Select a route…</option>
                    @for (var routeIndex = 0; routeIndex < routeChoices.Count; routeIndex++)
                    {
                        var routeOption = routeChoices[routeIndex];
                        <option value="@routeIndex">@routeOption.Metadata.Name</option>
                    }
                </select>
                <p class="hint">@((selectedRoute is null) ? "Import a route package to populate this list." : selectedRoute.Metadata.RouteId + " · " + selectedRoute.Metadata.Name)</p>
            </div>
            <div class="or-mainform-group">
                <h2>Mode</h2>
                <div class="or-mode-switch" role="radiogroup" aria-label="Game mode">
                    <label><input type="radio" name="or-mode" value="activity" checked="@isActivityMode" @onchange="() => SetMode(true)" /> Activity</label>
                    <label><input type="radio" name="or-mode" value="timetable" checked="@(!isActivityMode)" @onchange="() => SetMode(false)" /> Timetable</label>
                </div>
                @if (isActivityMode)
                {
                    <div class="or-mode-panel">
                        <label for="or-main-activity">Activity</label>
                        <select id="or-main-activity" value="@(isExploreMode ? "__explore__" : selectedActivityPath)" @onchange="SelectActivity" disabled="@(selectedRoute is null || isLoading)">
                            <option value="">Select an activity…</option>
                            <option value="__explore__">Explore</option>
                            @foreach (var activityPath in ActivityChoices)
                            {
                                <option value="@activityPath">@System.IO.Path.GetFileNameWithoutExtension(activityPath)</option>
                            }
                        </select>
                        @if (consistCatalog is { Consists.Count: > 0 })
                        {
                            <label for="or-main-locomotive">Locomotive</label>
                            <select id="or-main-locomotive" value="@SelectedLocomotiveKey" @onchange="SelectLocomotive" disabled="@isLoading">
                                <option value="">Select a locomotive…</option>
                                @foreach (var locomotive in LocomotiveChoices)
                                {
                                    <option value="@($"{locomotive.ConsistName}|{locomotive.Uid}")">@locomotive.CarName · @locomotive.ConsistName</option>
                                }
                            </select>
                            <label for="or-main-consist">Consist</label>
                            <select id="or-main-consist" value="@SelectedConsist?.Name" @onchange="SelectConsist" disabled="@isLoading">
                                @foreach (var consist in consistCatalog.Consists)
                                {
                                    <option value="@consist.Name">@consist.Name · @consist.Cars.Count cars</option>
                                }
                            </select>
                        }
                        @if (isExploreMode)
                        {
                            <label for="or-explore-start">Starting at</label>
                            <select id="or-explore-start" value="@selectedExploreStart" @onchange="SelectExploreStart" disabled="@(ExploreStartChoices.Count == 0)">
                                <option value="">Select a starting location…</option>
                                @foreach (var start in ExploreStartChoices)
                                {
                                    <option value="@start">@start</option>
                                }
                            </select>
                            <label for="or-explore-destination">Heading to</label>
                            <select id="or-explore-destination" value="@selectedExplorePathId" @onchange="SelectExplorePath" disabled="@(ExploreDestinationChoices.Count == 0)">
                                <option value="">Select a destination…</option>
                                @foreach (var path in ExploreDestinationChoices)
                                {
                                    <option value="@path.PathId">@path.End · @path.Name</option>
                                }
                            </select>
                            <p class="hint">Explore path selection is read from native .pat files. Start remains unavailable until the selected path is bound to the TDB driving traversal.</p>
                        }
                        @if (selectedActivityMetadata is { } activity)
                        {
                            <dl class="or-compact-details">
                                <dt>Time</dt><dd>@activity.StartTime</dd>
                                <dt>Duration</dt><dd>@(activity.DurationMinutes / 60) h @(activity.DurationMinutes % 60) min</dd>
                                <dt>Season</dt><dd>@activity.SeasonName</dd>
                                <dt>Weather</dt><dd>@activity.WeatherName</dd>
                                <dt>Difficulty</dt><dd>@activity.DifficultyName</dd>
                            </dl>
                        }
                        else
                        {
                            <p class="hint">Select a route and activity. Activity-specific locomotive, consist, start location and environment values are resolved from its native definition.</p>
                        }
                    </div>
                }
                else
                {
                    <div class="or-mode-panel">
                        <label for="or-timetable-set">Timetable set</label>
                        <select id="or-timetable-set" value="@selectedTimetableSetPath" @onchange="SelectTimetableSet" disabled="@(composite is null || isLoading)">
                            <option value="">Select a timetable set…</option>
                            @foreach (var timetableSet in TimetableSetChoices)
                            {
                                <option value="@timetableSet">@System.IO.Path.GetFileName(timetableSet)</option>
                            }
                        </select>
                        <label for="or-timetable-file">Timetable</label>
                        <select id="or-timetable-file" value="@selectedTimetablePath" @onchange="SelectTimetable" disabled="@(string.IsNullOrWhiteSpace(selectedTimetableSetPath) || isLoading)">
                            <option value="">Select a timetable…</option>
                            @foreach (var timetablePath in TimetablesInSelectedSet)
                            {
                                <option value="@timetablePath">@System.IO.Path.GetFileName(timetablePath)</option>
                            }
                        </select>
                        <label for="or-timetable-day">Day</label>
                        <select id="or-timetable-day" disabled><option>Native day selection not yet parsed</option></select>
                        <label for="or-timetable-season">Season</label>
                        <select id="or-timetable-season" disabled><option>Native season selection not yet connected</option></select>
                        <label for="or-timetable-weather">Weather</label>
                        <select id="or-timetable-weather" disabled><option>Native weather selection not yet connected</option></select>
                        <label for="or-timetable-weather-file">Weather file</label>
                        <select id="or-timetable-weather-file" disabled><option>Weather-file catalog not yet ported</option></select>
                        <label for="or-timetable-train">Train</label>
                        <select id="or-timetable-train" value="@selectedTimetableTrain" @onchange="SelectTimetableTrain" disabled="@(selectedTimetable is null)">
                            <option value="">Select a train…</option>
                            @foreach (var train in selectedTimetable?.Trains ?? Array.Empty<NativeTimetableTrainDefinition>())
                            {
                                <option value="@train.Train">@train.Train</option>
                            }
                        </select>
                        @if (selectedTimetable is { } timetable)
                        {
                            <p class="hint">@timetable.Description</p>
                            @if (!string.IsNullOrWhiteSpace(selectedTimetableTrainDefinition?.Briefing))
                            {
                                <p>@selectedTimetableTrainDefinition.Briefing</p>
                            }
                            <p class="hint">@timetable.Trains.Count train column(s) found · native timetable selection only; timetable dispatch is not yet wired to Start.</p>
                        }
                        else
                        {
                            <p class="hint">Timetable files are discovered from imported route and content packages.</p>
                        }
                    </div>
                }
            </div>
            <div class="or-mainform-group">
                <h2>Singleplayer</h2>
                <div class="or-action-row">
                    <a class="or-menu-command primary @(CanStartSelectedMode ? "" : "disabled")" href="@(CanStartSelectedMode ? "#driving-controls" : "#route-heading")" aria-disabled="@(!CanStartSelectedMode)">Start</a>
                    <button type="button" disabled title="Resume and replay save-state selection is not yet ported">Resume / Replay…</button>
                </div>
                <p class="hint">Start is enabled only when the selected route, connected track, consist and simulation session are ready.</p>
            </div>
            <div class="or-mainform-group">
                <h2>Multiplayer</h2>
                <fieldset disabled class="or-multiplayer-disabled">
                    <label><input type="radio" name="or-mp-mode" checked /> Client</label>
                    <label><input type="radio" name="or-mp-mode" /> Server</label>
                    <label>User name <input type="text" /></label>
                    <label>Host/port <input type="text" /></label>
                    <div class="or-action-row"><button type="button">Start MP</button><button type="button">Resume MP</button></div>
                </fieldset>
                <p class="hint">Unavailable: the browser-compatible multiplayer transport and session lifecycle have not been ported.</p>
            </div>
        </aside>
        <section class="or-mainform-details" aria-label="Main menu commands and details">
            <div class="or-mainform-command-groups">
                <div class="or-mainform-group">
                    <h2>Open Rails</h2>
                    <div class="or-action-row">
                        <button type="button" @onclick="OpenOptionsDialog">Options</button>
                        <a class="or-menu-command" href="#content-packages">Content</a>
                        <details class="or-menu-dropdown">
                            <summary>Tools ▼</summary>
                            <div class="or-dropdown-content">
                                <a href="#content-packages">Content packages</a>
                                <a href="#route-heading">Route diagnostics</a>
                                <button type="button" disabled title="The upstream TestingForm is not yet ported">Testing</button>
                            </div>
                        </details>
                        <details class="or-menu-dropdown">
                            <summary>Documents ▼</summary>
                            <div class="or-dropdown-content">
                                <a href="https://open-rails.readthedocs.io/" target="_blank" rel="noopener noreferrer">User guide</a>
                                <a href="https://open-rails.readthedocs.io/en/latest/" target="_blank" rel="noopener noreferrer">Documentation</a>
                                <a href="https://github.com/openrails/openrails" target="_blank" rel="noopener noreferrer">Source repository</a>
                            </div>
                        </details>
                    </div>
                    <label class="or-logging-toggle"><input type="checkbox" @bind="loggingEnabled" @bind:after="SaveBrowserPreferencesAsync" /> Logging</label>
                    <p class="hint">Logging preference is currently a UI preference; native log-file routing is not yet ported to the browser.</p>
                </div>
                <div class="or-mainform-group or-notifications">
                    <h2>Notifications</h2>
                    <span class="or-notification-indicator" aria-label="Notifications unavailable">—</span>
                    <p class="hint">Open Rails notification feed is not yet connected in this browser build.</p>
                </div>
            </div>
            @if (showOptionsDialog)
            {
                <section class="or-options-dialog" role="dialog" aria-modal="true" aria-labelledby="or-options-title" tabindex="-1" @onkeydown="HandleOptionsDialogKeyDown">
                    <header class="or-options-header">
                        <h2 id="or-options-title">Options</h2>
                        <button type="button" @onclick="CancelOptionsDialog" aria-label="Close Options">Close</button>
                    </header>
                    <nav class="or-options-tabs" role="tablist" aria-label="Options pages">
                        @foreach (var tab in OptionTabs)
                        {
                            <button type="button" role="tab" id="@($"or-options-tab-{tab.Replace(" ", "-").ToLowerInvariant()}")" aria-controls="or-options-page" aria-selected="@(selectedOptionsTab == tab)" @onclick="() => SelectOptionsTab(tab)">@tab</button>
                        }
                    </nav>
                    <div class="or-options-page" id="or-options-page" role="tabpanel" aria-labelledby="@($"or-options-tab-{selectedOptionsTab.Replace(" ", "-").ToLowerInvariant()}")">
                        @switch (selectedOptionsTab)
                        {
                            case "General":
                                <h3>General</h3>
                                <p>Autosave, language, units, update mode, telemetry and general simulator preferences.</p>
                                <label><input type="checkbox" @bind="browserAutosaveEnabled" @bind:after="SaveBrowserPreferencesAsync" /> Browser session autosave preference</label>
                                <label>Autosave interval <select @bind="browserAutosaveMinutes" @bind:after="SaveBrowserPreferencesAsync"><option value="15">15 mins</option><option value="30">30 mins</option><option value="60">60 mins</option></select></label>
                                <p class="hint">These browser preference controls are local UI state only; native save-game autosave is not yet connected.</p>
                                break;
                            case "Audio":
                                <h3>Audio</h3>
                                <p>Upstream controls: sound volume, external sound heard internally, sound detail level.</p>
                                <label>Browser audio output <input type="range" min="0" max="100" @bind="browserAudioVolume" @bind:after="SaveBrowserPreferencesAsync" /> @browserAudioVolume%</label>
                                <p class="hint">Volume preference is not yet wired to the simulator audio mixer.</p>
                                break;
                            case "Video":
                                <h3>Video</h3>
                                <p>Upstream controls: viewing distance, vertical FOV, object density, LOD bias, anti-aliasing, shadows, signal glow, overhead wires, distant mountains and VSync.</p>
                                <p class="hint">The browser renderer currently exposes its own camera and quality controls in the route viewer. Native Open Rails video settings are not yet mapped to the WebGL renderer.</p>
                                break;
                            case "Simulation":
                                <h3>Simulation</h3>
                                <p>Upstream controls: locomotive start state, activity options, simple controls and physics, curve speed limits, coupler breakage, advanced adhesion, TCS scripts, alerter and air-brake options.</p>
                                <p class="hint">The native option model and persistence have not yet been ported. Do not treat these as active simulator settings.</p>
                                break;
                            case "Keyboard":
                                <h3>Keyboard</h3>
                                <p>Native keyboard command mapping, export, defaults and conflict checking.</p>
                                <p class="hint">Browser driving controls currently use the implemented keyboard bindings shown with the cab/driving panel. Full native command-map editing is pending.</p>
                                break;
                            case "RailDriver":
                                <h3>RailDriver</h3>
                                <p>Lever mapping, reverse directions, full-range throttle, export, defaults and calibration.</p>
                                <p class="hint">Hardware integration is unavailable in this browser port.</p>
                                break;
                            case "Data logger":
                                <h3>Data logger</h3>
                                <p>Physics, performance, steam, station-stop and train-speed logging; separators and logging intervals.</p>
                                <p class="hint">Native data logger output is not yet ported.</p>
                                break;
                            case "Evaluation":
                                <h3>Evaluation</h3>
                                <p>Evaluation logging intervals and event categories.</p>
                                <p class="hint">Native evaluation logging is not yet ported.</p>
                                break;
                            case "System":
                                <h3>System</h3>
                                <p>Window size, windowed mode, language, update mode, performance tuner, web-server port and system confirmations.</p>
                                <p class="hint">Browser viewport and runtime diagnostics are browser-managed; native system controls are not applicable or not yet ported.</p>
                                break;
                            case "Experimental":
                                <h3>Experimental</h3>
                                <p>Adhesion randomization, activity randomization, questionable braking parameter correction, shape warnings, MSTS environments and legacy superelevation.</p>
                                <p class="hint">Experimental simulation flags are not yet connected to the native simulation model.</p>
                                break;
                        }
                    </div>
                    <footer class="or-options-footer">
                        <span class="hint">Original Open Rails Options tab inventory; unsupported settings remain clearly identified.</span>
                        <button type="button" @onclick="CommitOptionsDialog">OK</button>
                        <button type="button" @onclick="CancelOptionsDialog">Cancel</button>
                    </footer>
                </section>
            }
        </section>
    </section>

    <section class="route-choice" aria-labelledby="route-heading">
        <h2 id="route-heading">Route</h2>
        <div class="route-options">
            <label class="route-card upload-card">
                <span class="route-card-title">Browse route package…</span>
                <span class="route-card-tag">Open Rails / MSTS ZIP</span>
                <span class="route-card-description">Select a route archive containing its .trk, .tdb, TSECTION.DAT and route assets.</span>
                <InputFile OnChange="HandleRouteZip" accept=".zip,application/zip" disabled="@isLoading" />
            </label>
        </div>

        @if (isLoading)
        {
            <p class="status">@(largeUploadInProgress ? "Streaming large ZIP into browser disk storage…" : "Scanning ZIP and reading route metadata…")</p>
        }
        @if (largeUploadInProgress)
        {
            <p class="hint">Large archive upload: @((largeUploadBytes / 1_000_000_000d).ToString("N2")) / @((largeUploadTotalBytes / 1_000_000_000d).ToString("N2")) GB (@largeUploadPercent%)</p>
            <progress max="100" value="@largeUploadPercent"></progress>
        }
        @if (!string.IsNullOrWhiteSpace(largePackageMessage))
        {
            <p class="success">@largePackageMessage</p>
        }
        @if (storedPackages.Count > 0)
        {
            <div class="route-details">
                <h3>Large archives stored in this browser</h3>
                @foreach (var package in storedPackages)
                {
                    <div class="route-row">
                        <strong>@package.FileName</strong>
                        <span>@((package.SizeBytes / 1_000_000_000d).ToString("N2")) GB</span>
                        <small>OPFS · persistent protection: @(package.PersistentStorageGranted ? "granted" : "not granted")</small>
                        <button type="button" @onclick="() => IndexStoredPackageAsync(package)" disabled="@isLoading">Index ZIP contents</button>
                        <button type="button" @onclick="() => DeleteStoredPackageAsync(package)" disabled="@isLoading">Delete stored archive</button>
                        @if (indexedPackages.TryGetValue(package.Id, out var archiveIndex))
                        {
                            <small>ZIP index: @archiveIndex.EntryCount files · @archiveIndex.RouteFiles.Count route metadata file(s) · @((archiveIndex.TotalUncompressedBytes / 1_000_000_000d).ToString("N2")) GB uncompressed</small>
                            @foreach (var routeFile in archiveIndex.RouteFiles)
                            {
                                <small>Route candidate: <code>@routeFile</code></small>
                                @if (stagedRouteMetadata.TryGetValue(package.Id, out var stagedRoutes))
                                {
                                    var stagedRoute = stagedRoutes.FirstOrDefault(route => route.Path == routeFile);
                                    @if (stagedRoute is not null)
                                    {
                                        <small class="success">Parsed with upstream STFReader: @stagedRoute.Metadata.Name · ID @stagedRoute.Metadata.RouteId</small>
                                        <small>@stagedRoute.Metadata.Description</small>
                                        <button type="button" @onclick="() => LoadStagedRouteAsync(package, routeFile, stagedRoute.Metadata)" disabled="@isLoading">Load route into simulator</button>
                                    }
                                }
                            }
                            @if (archiveIndex.RouteFiles.Count == 0)
                            {
                                <small class="hint">No .trk route metadata files were found.</small>
                            }
                        }
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="error" role="alert">@errorMessage</p>
        }
        @if (routeChoices.Count > 0)
        {
            <div class="or-route-picker">
                <label for="or-route-select">Select route</label>
                <select id="or-route-select" value="@SelectedRouteIndex" @onchange="SelectRouteFromMenu" disabled="@isLoading">
                    <option value="-1">Select an installed route…</option>
                    @for (var routeIndex = 0; routeIndex < routeChoices.Count; routeIndex++)
                    {
                        var routeOption = routeChoices[routeIndex];
                        <option value="@routeIndex">@routeOption.Metadata.Name (@routeOption.Metadata.RouteId)</option>
                    }
                </select>
            </div>
        }

        @if (selectedRoute is not null)
        {
            <div class="route-details">
                <h3>@selectedRoute.Metadata.Name</h3>
                <p>@selectedRoute.Metadata.Description</p>
                <dl>
                    <dt>Route ID</dt><dd>@selectedRoute.Metadata.RouteId</dd>
                    <dt>Electrified</dt><dd>@(selectedRoute.Metadata.Electrified ? "Yes" : "No")</dd>
                    <dt>Maximum line voltage</dt><dd>@selectedRoute.Metadata.MaxLineVoltage</dd>
                    <dt>Metadata file</dt><dd><code>@selectedRoute.MetadataFile</code></dd>
                </dl>
                <p class="success">Route metadata loaded successfully 💚</p>
                @if (string.Equals(selectedRoute.Metadata.RouteId, "SCE", StringComparison.OrdinalIgnoreCase))
                {
                    <p class="hint">Demo Model 1 © Making Tracks Ltd. Used and distributed with permission from the Open Rails Management Team.</p>
                }
                @if (isBuildingRoute)
                {
                    <p class="status">Building route track network from the imported Open Rails data…</p>
                }
                @if (!string.IsNullOrWhiteSpace(routeBuildMessage))
                {
                    <p class="@(loadedRoute is null ? "error" : "success")">@routeBuildMessage</p>
                }
                @if (loadedRoute is not null)
                {
                    @if (consistCatalog is not null && consistCatalog.Consists.Count > 0)
                    {
                        <div class="route-details">
                            <label for="active-consist">Train consist for simulation</label>
                            <select id="active-consist" value="@SelectedConsist?.Name" @onchange="SelectConsist">
                                @foreach (var consist in consistCatalog.Consists)
                                {
                                    <option value="@consist.Name">@consist.Name · @consist.Cars.Count cars</option>
                                }
                            </select>
                        </div>
                    }
                    @if (serviceChoices.Count > 0)
                    {
                        <div class="route-details">
                            <h3>Original service definitions</h3>
                            <p class="hint">@loadedServices.Count service definitions parsed from TRAINS/SERVICES</p>
                            <p class="hint">@loadedRoutePaths.Count route paths parsed · @loadedRoutePaths.Sum(path => path.Nodes.Count) linked path nodes</p>
                            <label for="selected-service">Service consist profile</label>
                            <select id="selected-service" value="@selectedServicePath" @onchange="SelectService">
                                <option value="">Use manually selected consist</option>
                                @foreach (var binding in serviceRouteBindings.Where(binding => binding.IsRunnable))
                                {
                                    <option value="@binding.Service.SourcePath">@binding.Service.Name · @binding.Consist!.Name · @binding.Service.InitialSpeedMetersPerSecond.ToString("N1") m/s</option>
                                }
                            </select>
                            @if (SelectedServiceBinding is { } activeService)
                            {
                                <p class="hint">Driving service profile: @activeService.Service.Name · @activeService.Service.PathId · initial speed @((activeService.Service.InitialSpeedMetersPerSecond * 3.6f).ToString("N1")) km/h. The service path is validated and displayed above; movement currently follows the selected connected TDB route.</p>
                            }
                            @foreach (var path in loadedRoutePaths)
                            {
                                <p><strong>@path.Name</strong> · @path.Start → @path.End · @path.Nodes.Count nodes · @(path.IsPlayerPath ? "Player path" : "AI-only path")</p>
                                @foreach (var diagnostic in path.Diagnostics)
                                {
                                    <p class="hint">@path.PathId: @diagnostic</p>
                                }
                            }
                            @foreach (var binding in serviceRouteBindings)
                            {
                                <p><strong>@binding.Service.Name</strong> · consist @binding.Service.TrainConfig · path @binding.Service.PathId · initial speed @((binding.Service.InitialSpeedMetersPerSecond * 3.6f).ToString("N1")) km/h</p>
                                @if (binding.Path is null)
                                {
                                    <p class="hint">@binding.Diagnostic</p>
                                }
                                else
                                {
                                    <p class="hint">Main route trace: @binding.MainTrace.NodeIndices.Count nodes, @binding.MainTrace.Points.Count positioned points · consist @(binding.Consist?.Name ?? "not found") · @(binding.IsRunnable ? "references resolved" : "not runnable")</p>
                                    @foreach (var diagnostic in binding.MainTrace.Diagnostics)
                                    {
                                        <p class="hint">@diagnostic</p>
                                    }
                                }
                            }
                        </div>
                    }
                    @if (ActivityChoices.Count > 0)
                    {
                        <div class="route-details">
                            <label for="selected-activity">Single-player activity</label>
                            <select id="selected-activity" value="@selectedActivityPath" @onchange="SelectActivity">
                                <option value="">No activity selected · route preview</option>
                                @foreach (var activityPath in ActivityChoices)
                                {
                                    <option value="@activityPath">@System.IO.Path.GetFileNameWithoutExtension(activityPath)</option>
                                }
                            </select>
                            @if (!string.IsNullOrWhiteSpace(selectedActivityPath))
                            {
                                @if (selectedActivityMetadata is not null)
                                {
                                    <div class="activity-summary">
                                        <h4>@selectedActivityMetadata.Name</h4>
                                        <p>@selectedActivityMetadata.Description</p>
                                        @if (!string.IsNullOrWhiteSpace(selectedActivityMetadata.Briefing))
                                        {
                                            <p>@selectedActivityMetadata.Briefing</p>
                                        }
                                        <dl>
                                            <dt>Mode</dt><dd>@selectedActivityMetadata.ModeName</dd>
                                            <dt>Start time</dt><dd>@selectedActivityMetadata.StartTime</dd>
                                            <dt>Season / weather</dt><dd>@selectedActivityMetadata.SeasonName / @selectedActivityMetadata.WeatherName</dd>
                                            <dt>Duration</dt><dd>@(selectedActivityMetadata.DurationMinutes / 60) h @(selectedActivityMetadata.DurationMinutes % 60) min</dd>
                                            <dt>Difficulty</dt><dd>@selectedActivityMetadata.DifficultyName</dd>
                                            <dt>Path ID</dt><dd>@(selectedActivityMetadata.PathId ?? "Not specified")</dd>
                                            <dt>Starting speed</dt><dd>@((selectedActivityMetadata.StartingSpeedMetersPerSecond * 3.6f).ToString("N1")) km/h</dd>
                                        </dl>
                                        @if (selectedActivityPassengerService is { Stops.Count: > 0 } passengerService)
                                        {
                                            <h4>Passenger timetable · @passengerService.ServiceName</h4>
                                            <p class="hint">Player service starts at @TimeSpan.FromSeconds(passengerService.StartTimeSeconds).ToString(@"hh\:mm\:ss") · @passengerService.Stops.Count scheduled platform stops</p>
                                            <div class="table-scroll">
                                                <table>
                                                    <thead><tr><th>Platform item</th><th>Arrival</th><th>Departure</th><th>Distance down path</th></tr></thead>
                                                    <tbody>
                                                        @foreach (var stop in passengerService.Stops)
                                                        {
                                                            <tr>
                                                                <td>@stop.PlatformStartId</td>
                                                                <td>@DateTime.MinValue.AddSeconds(stop.ArrivalSeconds).ToString("HH:mm:ss")</td>
                                                                <td>@DateTime.MinValue.AddSeconds(stop.DepartureSeconds).ToString("HH:mm:ss")</td>
                                                                <td>@stop.DistanceDownPathMeters.ToString("N1") m</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        @if (selectedActivityPassengerPlatformBinding is { } platformBinding)
                                        {
                                            <p class="hint">Passenger platforms resolved against route TDB: @platformBinding.Stops.Count / @platformBinding.Service.Stops.Count</p>
                                            @foreach (var diagnostic in platformBinding.Diagnostics)
                                            {
                                                <p class="error">@diagnostic</p>
                                            }
                                        }
                                        <p class="hint">Native activity events loaded: @(selectedActivityEvents?.Events.Count ?? 0).</p>
                                        @if (!string.IsNullOrWhiteSpace(activityPathWarning))
                                        {
                                            <p class="hint">@activityPathWarning</p>
                                        }
                                        @if (activityStationStopProgress is { } stopProgress)
                                        {
                                            <p class="hint">Activity station stops: @stopProgress.VisitedStops / @stopProgress.TotalStops visited</p>
                                            @if (!stopProgress.PathTraceComplete)
                                            {
                                                <p class="error">The activity path contains broken links; AllStops completion is disabled.</p>
                                            }
                                        }
                                        @if (activityExecution is not null)
                                        {
                                            <div class="activity-summary">
                                                <p class="hint">Activity elapsed time: @TimeSpan.FromSeconds(activityExecution.ElapsedSeconds).ToString()</p>
                                                @if (activityExecution.PendingEvent is { } pendingEvent)
                                                {
                                                    <p class="success">Event @pendingEvent.EventId · @pendingEvent.EventName</p>
                                                    @if (!string.IsNullOrWhiteSpace(pendingEvent.Message))
                                                    {
                                                        <p>@pendingEvent.Message</p>
                                                    }
                                                    <button type="button" @onclick="AcknowledgeActivityEvent">Acknowledge event</button>
                                                }
                                                @if (activityExecution.IsEnded)
                                                {
                                                    <p class="success">Activity ended · @(activityExecution.LastAcknowledgedEvent?.ActivitySucceeded == true ? "Success" : "Failed")</p>
                                                }
                                                @foreach (var unsupported in activityExecution.UnsupportedEvents.Take(8))
                                                {
                                                    <p class="hint">@unsupported</p>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(activityParseError))
                                {
                                    <p class="error">@activityParseError</p>
                                }
                            }
                        </div>
                    }
                    @if (traversedRoute?.PendingJunctionNodeIndex is { } pendingJunction && RouteBranchOptions.Count > 1)
                    {
                        <div class="route-details">
                            <label for="route-branch-node">Continuation at junction node @pendingJunction</label>
                            <select id="route-branch-node"
                                value="@(selectedBranchTrackNodeIndices.TryGetValue(pendingJunction, out var selectedBranch) ? selectedBranch.ToString() : "automatic")"
                                @onchange="SelectRouteBranch">
                                <option value="automatic">Stop here until a branch is selected</option>
                                @foreach (var branch in RouteBranchOptions)
                                {
                                    <option value="@branch.TrackNodeIndex">TrackNode @branch.TrackNodeIndex · @branch.LengthMeters.ToString("N0") m</option>
                                }
                            </select>
                            <p class="hint">Choose the continuation at this junction. The route builder will then continue and ask again only if another junction is ambiguous.</p>
                        </div>
                    }
                    @if (RouteStartOptions.Count > 0)
                    {
                        <div class="route-details">
                            <label for="route-start-node">Connected route starting vector</label>
                            <select id="route-start-node" value="@selectedTrackNodeIndex" @onchange="SelectTrackStart">
                                @foreach (var path in RouteStartOptions)
                                {
                                    <option value="@path.TrackNodeIndex">TrackNode @path.TrackNodeIndex · @path.LengthMeters.ToString("N0") m</option>
                                }
                            </select>
                            <label for="route-start-direction">Traversal direction</label>
                            <select id="route-start-direction" value="@(reverseRouteStart ? "reverse" : "forward")" @onchange="SelectRouteDirection">
                                <option value="forward">Forward</option>
                                <option value="reverse">Reverse</option>
                            </select>
                            <p class="hint">Starting vectors are ordered by distance to the route's declared RouteStart position</p>
                        </div>
                    }
                    <dl>
                        <dt>Track database nodes</dt><dd>@loadedRoute.TrackDatabase.NodeCount</dd>
                        <dt>Connected vector paths</dt><dd>@loadedRoute.TrackNetwork.VectorPathCount</dd>
                        <dt>Traversed connected route</dt><dd>@(traversedRoute is null ? "Not available" : $"{traversedRoute.Segments.Count} vector nodes · {traversedRoute.LengthMeters:N1} m")</dd>
                    </dl>
                    @if (traversedRoute is not null && traversedRoute.Diagnostics.Count > 0)
                    {
                        <div class="route-details">
                            <h4>Route traversal diagnostics</h4>
                            <ul class="path-list">
                                @foreach (var diagnostic in traversedRoute.Diagnostics)
                                {
                                    <li>@diagnostic</li>
                                }
                            </ul>
                        </div>
                    }
                    <dl>
                        <dt>Parsed track length</dt><dd>@(loadedRoute.TrackNetwork.TotalTrackLengthMeters.ToString("N1")) m</dd>
                        <dt>Terrain tiles found</dt><dd>@loadedRoute.TerrainTiles.Found.Count</dd>
                        <dt>Terrain tiles missing</dt><dd>@loadedRoute.TerrainTiles.Missing.Count</dd>
                        <dt>Track shape files found</dt><dd>@loadedRoute.TrackShapeAssets.Found.Count</dd>
                        <dt>Track shape files missing</dt><dd>@loadedRoute.TrackShapeAssets.Missing.Count</dd>
                        <dt>World tiles found</dt><dd>@loadedRoute.WorldTiles.Found.Count</dd>
                        <dt>World tiles missing</dt><dd>@loadedRoute.WorldTiles.Missing.Count</dd>
                        <dt>Track shape placements</dt><dd>@loadedRoute.TrackShapePlacements.Count</dd>
                        <dt>Terrain patch meshes</dt><dd>Viewport streamed</dd>
                        <dt>Terrain textures decoded</dt><dd>Viewport streamed</dd>
                        <dt>Track shape meshes loaded</dt><dd>@loadedRoute.TrackShapeMeshes.LoadedMeshes.Count</dd>
                        <dt>Scenery tiles assembled</dt><dd>Viewport streamed</dd>
                        <dt>Scenery shape meshes</dt><dd>Viewport streamed</dd>
                    </dl>

                    <p class="hint">Terrain meshes, terrain textures, WORLD tiles, scenery shapes and scenery textures are decoded by the camera viewport streamer. The counters below cover route-open validation and do not imply that deferred assets have been loaded.</p>
                    <div class="route-details">
                        <h3>Route validation</h3>
                        <p class="@(loadedRoute.Validation.TrackNetworkUsable ? "success" : "error")">
                            @(loadedRoute.Validation.TrackNetworkUsable
                                ? "Track topology passed structural validation."
                                : "Track topology has critical issues; this route is not ready for a driving test.")
                        </p>
                        <dl>
                            <dt>Track network</dt><dd>@(loadedRoute.Validation.TrackNetworkUsable ? "Usable" : "Not usable")</dd>
                            <dt>Track diagnostics</dt><dd>@loadedRoute.Validation.TrackDiagnosticsCount</dd>
                            <dt>Missing terrain</dt><dd>@loadedRoute.Validation.MissingTerrainTiles</dd>
                            <dt>Failed terrain</dt><dd>@loadedRoute.Validation.FailedTerrainTiles</dd>
                            <dt>Missing track shapes</dt><dd>@loadedRoute.Validation.MissingTrackShapes</dd>
                            <dt>Failed track shapes</dt><dd>@loadedRoute.Validation.FailedTrackShapes</dd>
                            <dt>Missing world tiles</dt><dd>@loadedRoute.Validation.MissingWorldTiles</dd>
                            <dt>Failed world tiles</dt><dd>@loadedRoute.Validation.FailedWorldTiles</dd>
                            <dt>Missing world shapes</dt><dd>@loadedRoute.Validation.MissingWorldShapes</dd>
                            <dt>Failed world shapes</dt><dd>@loadedRoute.Validation.FailedWorldShapes</dd>
                            <dt>Missing textures</dt><dd>@loadedRoute.Validation.MissingTextures</dd>
                            <dt>Failed textures</dt><dd>@loadedRoute.Validation.FailedTextures</dd>
                            <dt>Total diagnostics</dt><dd>@loadedRoute.Validation.Issues.Count</dd>
                        </dl>
                        @if (loadedRoute.Validation.Issues.Count > 0)
                        {
                            <h4>First 50 route diagnostics</h4>
                            <ul class="path-list">
                                @foreach (var issue in loadedRoute.Validation.Issues.Take(50))
                                {
                                    <li><strong>@issue.Category:</strong> @issue.Message</li>
                                }
                            </ul>
                            @if (loadedRoute.Validation.Issues.Count > 50)
                            {
                                <p class="hint">Showing 50 of @loadedRoute.Validation.Issues.Count diagnostics.</p>
                            }
                        }
                    </div>
                    @if (simulationSetup is not null)
                    {
                        <div class="route-details">
                            <h3>Train simulation setup</h3>
                            <p class="success">Fixed-step consist session initialized · @simulationSetup.InitialState.Cars.Count vehicle(s) · 60 Hz physics step</p>
                            <p class="hint">Parsed coupler ratings: @RatedCouplerLimitCount/@simulationSetup.CouplerForceLimits.Count consist boundaries</p>
                            <p class="hint">Vehicles with parsed Davis resistance: @DavisResistanceCoverage/@simulationSetup.InitialState.Cars.Count</p>
                            <p class="hint">Initial speed: @((simulationSetup.InitialState.Cars[0].SpeedMetersPerSecond * 3.6).ToString("N1")) km/h · route length: @traversedRoute?.LengthMeters.ToString("N0") m</p>
                            @foreach (var diagnostic in simulationSetup.Diagnostics)
                            {
                                <p class="hint">@diagnostic</p>
                            }
                        </div>
                    }
                    @if (SelectedCabView is { } cabView)
                    {
                        <div class="route-details">
                            <h3>Original locomotive cab</h3>
                            <p class="hint">Loaded from @cabView.SourcePath · @cabView.Controls.Count original controls</p>
                            <CabViewPanel Store="composite" Definition="cabView" Controller="drivingController" />
                        </div>
                    }
                    @if (loadedRoute?.SignalConfiguration is { } signalConfiguration)
                    {
                        <div class="route-details">
                            <h3>Route signal configuration</h3>
                            <p>@signalConfiguration.SignalTypes.Count signal types · @signalConfiguration.ScriptFiles.Count declared script files · @loadedRoute.SignalScripts?.Scripts.Count indexed scripts · @signalConfiguration.NormalSubtypes.Count normal subtypes</p>
                            @foreach (var signalType in signalConfiguration.SignalTypes.Values)
                            {
                                <p>@signalType.Name · @signalType.Function · @signalType.Aspects.Count aspects · @signalType.Script</p>
                            }
                            @foreach (var diagnostic in signalConfiguration.Diagnostics)
                            {
                                <p class="hint">@diagnostic</p>
                            }
                            @foreach (var diagnostic in loadedRoute.SignalScripts?.Diagnostics ?? Array.Empty<string>())
                            {
                                <p class="hint">@diagnostic</p>
                            }
                        </div>
                    }
                    @if (currentSignalIndications.Count > 0)
                    {
                        <div class="route-details">
                            <h3>Live route signalling</h3>
                            <p class="hint">Occupancy is derived from every vehicle body, including trailing cars, against the selected TDB vector-node route.</p>
                            @foreach (var indication in currentSignalIndications)
                            {
                                <p class="@(indication.Aspect == RouteSignalAspect.Stop ? "error" : indication.Aspect == RouteSignalAspect.Approach ? "hint" : "success")">
                                    Signal item @indication.Signal.TrackItemIndex · @indication.Signal.SignalType · @indication.Aspect
                                    @if (!string.IsNullOrWhiteSpace(indication.NativeAspect))
                                    {
                                        <span> · native @indication.NativeAspect · draw state @indication.DrawState</span>
                                    }
                                    @if (indication.SpeedLimitMetersPerSecond is { } speedLimit)
                                    {
                                        <span> · @((speedLimit * 3.6f).ToString("N1")) km/h</span>
                                    }
                                    — @indication.Reason
                                </p>
                            }
                        </div>
                    }
                    @if (CanDriveLoadedRoute)
                    {
                        <p class="success" role="status">Playable route test ready: track network, connected route, consist physics, and driving controller are initialized.</p>
                        <div id="driving-controls">
                            <TrainDrivingControls @key="drivingController"
                                Controller="drivingController!"
                                Consist="SelectedConsist"
                                StorageKey="@SimulationSnapshotKey"
                                AiServiceRoutePlan="(selectedServiceRoutePlan?.SupportsAiPathFollowing == true ? selectedServiceRoutePlan : null)"
                                AiServiceSignalConstraints="AiServiceSignalConstraints"
                                MotionChanged="OnTrainMotionChanged" />
                        </div>
                    }
                    else if (drivingController is not null)
                    {
                        <p class="error" role="status">Driving controls are withheld until the route has a usable track network, a connected route, a resolved consist, and an initialized simulation session. The route preview remains available for diagnostics.</p>
                    }
                    <RouteTerrainViewer Route="loadedRoute" Store="composite"
                        Consist="SelectedConsist"
                        CarAssets="consistCatalog?.CarAssets ?? Array.Empty<ConsistCarAssetReference>()"
                        MotionRoute="traversedRoute"
                        MotionState="currentMotionState ?? simulationSetup?.InitialState"
                        SimulationTimeSeconds="drivingController?.SimulationTimeSeconds ?? 0" />
                    @if (loadedRoute.TrackNetwork.Diagnostics.Count > 0 || loadedRoute.TrackShapeAssets.Missing.Count > 0 || (traversedRoute?.Diagnostics.Count ?? 0) > 0)
                    {
                        <p class="hint">Route data diagnostics: @(loadedRoute.TrackNetwork.Diagnostics.Count + loadedRoute.TrackShapeAssets.Missing.Count + (traversedRoute?.Diagnostics.Count ?? 0))</p>
                        <ul class="path-list">
                            @foreach (var diagnostic in loadedRoute.TrackNetwork.Diagnostics.Take(10))
                            {
                                <li>@diagnostic</li>
                            }
                            @foreach (var missingShape in loadedRoute.TrackShapeAssets.Missing.Take(10))
                            {
                                <li>Track shape @missingShape.ShapeIndex: @missingShape.FileName — @missingShape.Reason</li>
                            }
                            @foreach (var diagnostic in (traversedRoute?.Diagnostics ?? Array.Empty<string>()).Take(10))
                            {
                                <li>Connected route: @diagnostic</li>
                            }
                        </ul>
                    }
                }
            </div>
        }
    </section>

    <section id="content-packages" class="import-panel" aria-labelledby="import-heading">
        <h2 id="import-heading">Content packages</h2>
        <p class="note">Import additional ZIP packages to create a layered virtual content namespace. Earlier packages have higher priority.</p>
        <InputFile OnChange="HandleFilesSelected" accept=".zip,application/zip" multiple disabled="@isLoading" />
        <p class="hint">ZIP only · Up to @(ZipContentStore.DefaultMaxBrowserArchiveBytes / (1024 * 1024)) MiB uses in-memory import; larger packages stream to browser disk (30 GB maximum) · First selected package gets highest priority</p>

        @if (layers.Count > 0)
        {
            <div class="package-summary">
                <p class="success">@(layers.Count) package(s) loaded</p>
                <p>@(composite?.Paths.Count ?? 0) unique virtual files available</p>
            </div>
            <h3>Package priority</h3>
            <ol class="path-list package-priority-list">
                @foreach (var layer in layers)
                {
                    var layerIndex = layers.IndexOf(layer);
                    <li>
                        <div><strong>@layer.Name</strong><span class="hint"> — @layer.Store.Paths.Count files · priority @(layerIndex + 1)</span></div>
                        <div class="package-actions">
                            <button type="button" @onclick="() => MovePackageAsync(layer, -1)" disabled="@(isLoading || layerIndex == 0)" aria-label="Move @layer.Name higher">Move up</button>
                            <button type="button" @onclick="() => MovePackageAsync(layer, 1)" disabled="@(isLoading || layerIndex == layers.Count - 1)" aria-label="Move @layer.Name lower">Move down</button>
                            <button type="button" @onclick="() => RemovePackageAsync(layer)" disabled="@isLoading" aria-label="Remove @layer.Name">Remove</button>
                        </div>
                    </li>
                }
            </ol>
            <h3>Resolved content namespace</h3>
            <ul class="path-list">
                @foreach (var path in (composite?.Paths ?? Array.Empty<string>()).Take(40))
                {
                    <li><code>@path</code><span class="hint"> — @composite!.GetSourcePackage(path)</span></li>
                }
            </ul>
            @if ((composite?.Paths.Count ?? 0) > 40)
            {
                <p class="hint">Showing the first 40 resolved paths.</p>
            }
            @if (consistCatalog is not null)
            {
                <h3>Train consists discovered</h3>
                <p class="hint">@consistCatalog.Consists.Count valid consist(s) · @consistCatalog.Issues.Count file issue(s) · @consistCatalog.CarAssets.Count(asset => asset.Found)/@consistCatalog.CarAssets.Count rolling-stock definitions resolved · @consistCatalog.CarAssets.Count(asset => asset.ShapeFound)/@consistCatalog.CarAssets.Count rolling-stock shapes resolved · @consistCatalog.TcsAssets.Count(asset => asset.Found)/@consistCatalog.TcsAssets.Count TCS scripts resolved</p>
                @foreach (var consist in consistCatalog.Consists)
                {
                    var tcsAsset = consistCatalog.TcsAssets.FirstOrDefault(asset => asset.ConsistName == consist.Name);
                    <details class="consist-entry">
                        <summary><strong>@consist.Name</strong> <span class="hint">— @consist.Cars.Count cars · @consist.SourcePath @(consist.SourcePackage is null ? "" : $"· {consist.SourcePackage}")</span></summary>
                        <dl>
                            <dt>Durability</dt><dd>@consist.Durability</dd>
                            <dt>Serial</dt><dd>@consist.Serial</dd>
                            <dt>Next wagon UID</dt><dd>@consist.NextWagonUid</dd>
                            @if (consist.MaxVelocity is not null)
                            {
                                <dt>Maximum velocity</dt><dd>@consist.MaxVelocity.A / @consist.MaxVelocity.B</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(consist.TrainControlSystemParametersFile))
                            {
                                <dt>Train-control parameters</dt><dd><code>@consist.TrainControlSystemParametersFile</code> — @(tcsAsset is null ? "unresolved" : tcsAsset.Found ? (tcsAsset.SourcePackage is null ? "found" : $"found in {tcsAsset.SourcePackage}") : "missing")</dd>
                            }
                        </dl>
                        <ol class="path-list">
                            @foreach (var car in consist.Cars)
                            {
                                var carAsset = consistCatalog.CarAssets.FirstOrDefault(asset => asset.ConsistName == consist.Name && asset.Uid == car.Uid);
                                <li>@(car.IsEngine ? "Engine" : car.IsEndOfTrain ? "EOT" : "Wagon"): @car.Name <span class="hint">(@car.Folder, UID @car.Uid@(car.Flipped ? ", flipped" : ""))</span>
                                    @if (carAsset is not null && !car.IsEndOfTrain)
                                    {
                                        <small class="hint">Shape: @(carAsset.Metadata?.ShapeFileName ?? "not declared") — @(carAsset.ShapeFound ? $"resolved from {carAsset.ShapeSourcePackage ?? "package"}" : carAsset.Metadata?.ShapeFileName is null ? "no shape reference" : "missing shape asset")</small>
                                        @if (carAsset.TractionMetadata is { } traction)
                                        {
                                            <small class="hint">Traction: max @traction.MaxForceNewtons.ToString("N0") N · continuous @traction.MaxContinuousForceNewtons.ToString("N0") N · max power @traction.MaxPowerWatts.ToString("N0") W · @(traction.TractionForceCurves is null ? "basic force model" : "original throttle/speed curve loaded")</small>
                                        }
                                    }
                                    @if (car.Loads is not null)
                                    {
                                        <ul>
                                            @foreach (var load in car.Loads)
                                            {
                                                <li>Load: @load.Name <span class="hint">(@load.Folder · @load.Position@(load.State is null ? "" : $" · {load.State}") · interpreted @load.ParsedPosition/@load.ParsedState)</span></li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ol>
                    </details>
                }
                @if (consistCatalog.Issues.Count > 0)
                {
                    <h4>Consist file diagnostics</h4>
                    <ul class="path-list">
                        @foreach (var issue in consistCatalog.Issues.Take(15))
                        {
                            <li><code>@issue.Path</code> — @issue.Message</li>
                        }
                    </ul>
                }
            }
        }
    </section>
    <footer class="or-mainform-footer">
        <strong>Open Rails</strong>
        <span>© Open Rails project · GPL source distribution</span>
        <span class="or-port-credit">Ported by geofss</span>
    </footer>
</main>

@code {
    private bool isActivityMode = true;
    private bool isExploreMode;
    private bool showOptionsDialog;
    private bool loggingEnabled = true;
    private bool browserAutosaveEnabled;
    private int browserAutosaveMinutes = 30;
    private int browserAudioVolume = 80;
    private bool optionsSnapshotLogging;
    private bool optionsSnapshotAutosave;
    private int optionsSnapshotAutosaveMinutes;
    private int optionsSnapshotAudioVolume;
    private string selectedOptionsTab = "General";
    private string? selectedExploreStart;
    private string? selectedExplorePathId;
    private string? selectedTimetableSetPath;
    private string? selectedTimetablePath;
    private string? selectedTimetableTrain;
    private NativeTimetableDefinition? selectedTimetable;
    private NativeTimetableTrainDefinition? selectedTimetableTrainDefinition;
    private static readonly string[] OptionTabs =
        ["General", "Audio", "Video", "Simulation", "Keyboard", "RailDriver", "Data logger", "Evaluation", "System", "Experimental"];
    private const string BrowserPreferencesKey = "portedopenrails.mainform.preferences.v1";
    private IReadOnlyList<ConsistCarAssetReference> LocomotiveChoices => consistCatalog?.CarAssets
        .Where(asset => asset.IsEngine).ToArray() ?? Array.Empty<ConsistCarAssetReference>();
    private string? SelectedLocomotiveKey
    {
        get
        {
            var engine = SelectedConsist?.Cars.FirstOrDefault(car => car.IsEngine);
            return engine is null || SelectedConsist is null ? null : $"{SelectedConsist.Name}|{engine.Uid}";
        }
    }

    private IReadOnlyList<string> ExploreStartChoices => loadedRoutePaths
        .Select(path => path.Start).Where(start => !string.IsNullOrWhiteSpace(start))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(start => start, StringComparer.OrdinalIgnoreCase).ToArray();
    private IReadOnlyList<RoutePathDefinition> ExploreDestinationChoices => loadedRoutePaths
        .Where(path => string.Equals(path.Start, selectedExploreStart, StringComparison.OrdinalIgnoreCase))
        .OrderBy(path => path.End, StringComparer.OrdinalIgnoreCase).ThenBy(path => path.Name, StringComparer.OrdinalIgnoreCase).ToArray();

    private IReadOnlyList<string> TimetableChoices => composite?.Paths
        .Where(path => path.EndsWith(".timetable", StringComparison.OrdinalIgnoreCase) ||
                       path.EndsWith(".tt", StringComparison.OrdinalIgnoreCase))
        .OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToArray() ?? Array.Empty<string>();
    private IReadOnlyList<string> TimetableSetChoices => TimetableChoices
        .Select(path => System.IO.Path.GetDirectoryName(path)?.Replace('\\', '/') ?? string.Empty)
        .Where(path => !string.IsNullOrWhiteSpace(path))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(path => path, StringComparer.OrdinalIgnoreCase).ToArray();
    private IReadOnlyList<string> TimetablesInSelectedSet => TimetableChoices
        .Where(path => string.Equals(
            System.IO.Path.GetDirectoryName(path)?.Replace('\\', '/'),
            selectedTimetableSetPath, StringComparison.OrdinalIgnoreCase)).ToArray();

    private async Task SetMode(bool activityMode)
    {
        isActivityMode = activityMode;
        if (activityMode)
        {
            selectedTimetableSetPath = null;
            selectedTimetablePath = null;
            selectedTimetable = null;
            selectedTimetableTrain = null;
            selectedTimetableTrainDefinition = null;
        }
        else
        {
            selectedActivityPath = null;
            selectedActivityMetadata = null;
            selectedActivityEvents = null;
            selectedActivityPassengerService = null;
            selectedActivityPassengerPlatformBinding = null;
            activityExecution = null;
            activityStationStopTracker = null;
            activityStationStopProgress = null;
            activityStartingSpeedMetersPerSecond = null;
            InitializeSimulationSetup();
        }
        await SaveBrowserPreferencesAsync();
    }

    private void SelectExploreStart(ChangeEventArgs args)
    {
        selectedExploreStart = args.Value?.ToString();
        selectedExplorePathId = ExploreDestinationChoices.FirstOrDefault()?.PathId;
    }

    private void SelectExplorePath(ChangeEventArgs args)
    {
        var pathId = args.Value?.ToString();
        selectedExplorePathId = ExploreDestinationChoices.Any(path =>
            string.Equals(path.PathId, pathId, StringComparison.OrdinalIgnoreCase)) ? pathId : null;
    }

    private void SelectLocomotive(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(value))
            return;
        var separator = value.LastIndexOf('|');
        if (separator <= 0 || !int.TryParse(value[(separator + 1)..], out var uid))
            return;
        var consistName = value[..separator];
        var consist = consistCatalog?.Consists.FirstOrDefault(item =>
            string.Equals(item.Name, consistName, StringComparison.OrdinalIgnoreCase) &&
            item.Cars.Any(car => car.Uid == uid && car.IsEngine));
        if (consist is null)
            return;
        selectedConsistName = consist.Name;
        selectedServicePath = null;
        InitializeSimulationSetup();
    }

    private async Task SaveBrowserPreferencesAsync()
    {
        var preferences = new BrowserUiPreferences(loggingEnabled, browserAutosaveEnabled,
            browserAutosaveMinutes, browserAudioVolume, isActivityMode);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", BrowserPreferencesKey,
                System.Text.Json.JsonSerializer.Serialize(preferences));
        }
        catch (JSException)
        {
