@page "/"
@using OpenRails.Web.Content
@using OpenRails.Web.Parsing
@using OpenRails.Web.Simulation
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

<main class="shell">
    <p class="eyebrow">OPEN RAILS · WEB PORT</p>
    <h1>PortedOpenRails</h1>
    <p class="status">Milestone 3 · Route track network</p>
    <p class="note">Choose the built-in preview or import your own route ZIP. Imported route metadata, track databases, and track-section geometry are read through the browser virtual content pipeline.</p>

    <section class="route-choice" aria-labelledby="route-heading">
        <h2 id="route-heading">Choose a route</h2>
        <div class="route-options">
            <button class="route-card @(selectedDefault ? "selected" : "")" @onclick="SelectDefaultRoute">
                <span class="route-card-title">Default Route</span>
                <span class="route-card-tag">Built-in preview</span>
                <span class="route-card-description">A starter route entry to explore the web-port interface. Track, scenery, and simulation are not included yet.</span>
            </button>
            <label class="route-card upload-card">
                <span class="route-card-title">Add Your Own Route</span>
                <span class="route-card-tag">Import route ZIP</span>
                <span class="route-card-description">Select ZIP content containing one or more .trk route metadata files.</span>
                <InputFile OnChange="HandleRouteZip" accept=".zip,application/zip" disabled="@isLoading" />
            </label>
        </div>

        @if (isLoading)
        {
            <p class="status">Scanning ZIP and reading route metadata…</p>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="error" role="alert">@errorMessage</p>
        }
        @if (routeChoices.Count > 0)
        {
            <div class="route-list">
                <h3>Routes found</h3>
                @foreach (var route in routeChoices)
                {
                    <button class="route-row @(selectedRoute?.Metadata.RouteId == route.Metadata.RouteId ? "selected" : "")" @onclick="() => SelectRoute(route)">
                        <strong>@route.Metadata.Name</strong>
                        <span>@route.Metadata.RouteId</span>
                        <small>@route.Metadata.Description</small>
                        <small>Source: @route.PackageName · @route.MetadataFile</small>
                    </button>
                }
            </div>
        }

        @if (selectedDefault)
        {
            <div class="route-details">
                <h3>Default Route · Preview</h3>
                <p>This built-in entry is a UI preview only. No route assets are bundled, and the simulator is not running yet.</p>
                <p class="success">Default route selected</p>
            </div>
        }
        else if (selectedRoute is not null)
        {
            <div class="route-details">
                <h3>@selectedRoute.Metadata.Name</h3>
                <p>@selectedRoute.Metadata.Description</p>
                <dl>
                    <dt>Route ID</dt><dd>@selectedRoute.Metadata.RouteId</dd>
                    <dt>Electrified</dt><dd>@(selectedRoute.Metadata.Electrified ? "Yes" : "No")</dd>
                    <dt>Maximum line voltage</dt><dd>@selectedRoute.Metadata.MaxLineVoltage</dd>
                    <dt>Metadata file</dt><dd><code>@selectedRoute.MetadataFile</code></dd>
                </dl>
                <p class="success">Route metadata loaded successfully 💚</p>
                @if (isBuildingRoute)
                {
                    <p class="status">Building route track network from the imported Open Rails data…</p>
                }
                @if (!string.IsNullOrWhiteSpace(routeBuildMessage))
                {
                    <p class="@(loadedRoute is null ? "error" : "success")">@routeBuildMessage</p>
                }
                @if (loadedRoute is not null)
                {
                    @if (consistCatalog is not null && consistCatalog.Consists.Count > 0)
                    {
                        <div class="route-details">
                            <label for="active-consist">Train consist for simulation</label>
                            <select id="active-consist" value="@SelectedConsist?.Name" @onchange="SelectConsist">
                                @foreach (var consist in consistCatalog.Consists)
                                {
                                    <option value="@consist.Name">@consist.Name · @consist.Cars.Count cars</option>
                                }
                            </select>
                        </div>
                    }
                    @if (ActivityChoices.Count > 0)
                    {
                        <div class="route-details">
                            <label for="selected-activity">Activity file selection (not runnable yet)</label>
                            <select id="selected-activity" value="@selectedActivityPath" @onchange="SelectActivity">
                                <option value="">No activity selected · route preview</option>
                                @foreach (var activityPath in ActivityChoices)
                                {
                                    <option value="@activityPath">@System.IO.Path.GetFileNameWithoutExtension(activityPath)</option>
                                }
                            </select>
                            @if (!string.IsNullOrWhiteSpace(selectedActivityPath))
                            {
                                <p class="hint">Selected activity file: <code>@selectedActivityPath</code>. Activity execution is not implemented yet.</p>
                            }
                        </div>
                    }
                    @if (traversedRoute?.PendingJunctionNodeIndex is { } pendingJunction && RouteBranchOptions.Count > 1)
                    {
                        <div class="route-details">
                            <label for="route-branch-node">Continuation at junction node @pendingJunction</label>
                            <select id="route-branch-node"
                                value="@(selectedBranchTrackNodeIndices.TryGetValue(pendingJunction, out var selectedBranch) ? selectedBranch.ToString() : "automatic")"
                                @onchange="SelectRouteBranch">
                                <option value="automatic">Stop here until a branch is selected</option>
                                @foreach (var branch in RouteBranchOptions)
                                {
                                    <option value="@branch.TrackNodeIndex">TrackNode @branch.TrackNodeIndex · @branch.LengthMeters.ToString("N0") m</option>
                                }
                            </select>
                            <p class="hint">Choose the continuation at this junction. The route builder will then continue and ask again only if another junction is ambiguous.</p>
                        </div>
                    }
                    @if (RouteStartOptions.Count > 0)
                    {
                        <div class="route-details">
                            <label for="route-start-node">Connected route starting vector</label>
                            <select id="route-start-node" value="@selectedTrackNodeIndex" @onchange="SelectTrackStart">
                                @foreach (var path in RouteStartOptions)
                                {
                                    <option value="@path.TrackNodeIndex">TrackNode @path.TrackNodeIndex · @path.LengthMeters.ToString("N0") m</option>
                                }
                            </select>
                            <label for="route-start-direction">Traversal direction</label>
                            <select id="route-start-direction" value="@(reverseRouteStart ? "reverse" : "forward")" @onchange="SelectRouteDirection">
                                <option value="forward">Forward</option>
                                <option value="reverse">Reverse</option>
                            </select>
                            <p class="hint">Starting vectors are ordered by distance to the route's declared RouteStart position</p>
                        </div>
                    }
                    <dl>
                        <dt>Track database nodes</dt><dd>@loadedRoute.TrackDatabase.NodeCount</dd>
                        <dt>Connected vector paths</dt><dd>@loadedRoute.TrackNetwork.VectorPathCount</dd>
                        <dt>Traversed connected route</dt><dd>@(traversedRoute is null ? "Not available" : $"{traversedRoute.Segments.Count} vector nodes · {traversedRoute.LengthMeters:N1} m")</dd>
                    </dl>
                    @if (traversedRoute is not null && traversedRoute.Diagnostics.Count > 0)
                    {
                        <div class="route-details">
                            <h4>Route traversal diagnostics</h4>
                            <ul class="path-list">
                                @foreach (var diagnostic in traversedRoute.Diagnostics)
                                {
                                    <li>@diagnostic</li>
                                }
                            </ul>
                        </div>
                    }
                    <dl>
                        <dt>Parsed track length</dt><dd>@(loadedRoute.TrackNetwork.TotalTrackLengthMeters.ToString("N1")) m</dd>
                        <dt>Terrain tiles found</dt><dd>@loadedRoute.TerrainTiles.Found.Count</dd>
                        <dt>Terrain tiles missing</dt><dd>@loadedRoute.TerrainTiles.Missing.Count</dd>
                        <dt>Track shape files found</dt><dd>@loadedRoute.TrackShapeAssets.Found.Count</dd>
                        <dt>Track shape files missing</dt><dd>@loadedRoute.TrackShapeAssets.Missing.Count</dd>
                        <dt>World tiles found</dt><dd>@loadedRoute.WorldTiles.Found.Count</dd>
                        <dt>World tiles missing</dt><dd>@loadedRoute.WorldTiles.Missing.Count</dd>
                        <dt>Track shape placements</dt><dd>@loadedRoute.TrackShapePlacements.Count</dd>
                        <dt>Terrain patch meshes</dt><dd>@loadedRoute.TerrainMeshes.Meshes.Sum(tile => tile.LodMeshes.FirstOrDefault()?.Patches.Count ?? 0)</dd>
                        <dt>Terrain textures decoded</dt><dd>@loadedRoute.TerrainTextures.Loaded.Count</dd>
                        <dt>Track shape meshes loaded</dt><dd>@loadedRoute.TrackShapeMeshes.LoadedMeshes.Count</dd>
                        <dt>Scenery tiles assembled</dt><dd>@loadedRoute.WorldScenery.Loaded.Count</dd>
                        <dt>Scenery shape meshes</dt><dd>@loadedRoute.WorldScenery.Loaded.Sum(tile => tile.ShapeMeshes.Count)</dd>
                    </dl>
                    @if (simulationSetup is not null)
                    {
                        <div class="route-details">
                            <h3>Train simulation setup</h3>
                            <p class="success">Fixed-step consist session initialized · @simulationSetup.InitialState.Cars.Count vehicle(s) · 60 Hz physics step</p>
                            <p class="hint">Parsed coupler ratings: @RatedCouplerLimitCount/@simulationSetup.CouplerForceLimits.Count consist boundaries</p>
                            <p class="hint">Vehicles with parsed Davis resistance: @DavisResistanceCoverage/@simulationSetup.InitialState.Cars.Count</p>
                            <p class="hint">Initial speed: @((simulationSetup.InitialState.Cars[0].SpeedMetersPerSecond * 3.6).ToString("N1")) km/h · route length: @traversedRoute?.LengthMeters.ToString("N0") m</p>
                            @foreach (var diagnostic in simulationSetup.Diagnostics)
                            {
                                <p class="hint">@diagnostic</p>
                            }
                        </div>
                    }
                    @if (drivingController is not null)
                    {
                        <TrainDrivingControls @key="drivingController"
                            Controller="drivingController"
                            Consist="SelectedConsist"
                            StorageKey="@SimulationSnapshotKey"
                            MotionChanged="OnTrainMotionChanged" />
                    }
                    <RouteTerrainViewer Route="loadedRoute" Store="composite"
                        Consist="SelectedConsist"
                        CarAssets="consistCatalog?.CarAssets ?? Array.Empty<ConsistCarAssetReference>()"
                        MotionRoute="traversedRoute"
                        MotionState="currentMotionState ?? simulationSetup?.InitialState" />
                    @if (loadedRoute.TrackNetwork.Diagnostics.Count > 0 || loadedRoute.TrackShapeAssets.Missing.Count > 0 || (traversedRoute?.Diagnostics.Count ?? 0) > 0)
                    {
                        <p class="hint">Route data diagnostics: @(loadedRoute.TrackNetwork.Diagnostics.Count + loadedRoute.TrackShapeAssets.Missing.Count + (traversedRoute?.Diagnostics.Count ?? 0))</p>
                        <ul class="path-list">
                            @foreach (var diagnostic in loadedRoute.TrackNetwork.Diagnostics.Take(10))
                            {
                                <li>@diagnostic</li>
                            }
                            @foreach (var missingShape in loadedRoute.TrackShapeAssets.Missing.Take(10))
                            {
                                <li>Track shape @missingShape.ShapeIndex: @missingShape.FileName — @missingShape.Reason</li>
                            }
                            @foreach (var diagnostic in (traversedRoute?.Diagnostics ?? Array.Empty<string>()).Take(10))
                            {
                                <li>Connected route: @diagnostic</li>
                            }
                        </ul>
                    }
                }
            </div>
        }
    </section>

    <section class="import-panel" aria-labelledby="import-heading">
        <h2 id="import-heading">Content packages</h2>
        <p class="note">Import additional ZIP packages to create a layered virtual content namespace. Earlier packages have higher priority.</p>
        <InputFile OnChange="HandleFilesSelected" accept=".zip,application/zip" multiple disabled="@isLoading" />
        <p class="hint">ZIP only · Maximum @(ZipContentStore.DefaultMaxBrowserArchiveBytes / (1024 * 1024)) MiB per package · First selected package gets highest priority</p>

        @if (layers.Count > 0)
        {
            <div class="package-summary">
                <p class="success">@(layers.Count) package(s) loaded</p>
                <p>@(composite?.Paths.Count ?? 0) unique virtual files available</p>
            </div>
            <h3>Package priority</h3>
            <ol class="path-list package-priority-list">
                @foreach (var layer in layers)
                {
                    var layerIndex = layers.IndexOf(layer);
                    <li>
                        <div><strong>@layer.Name</strong><span class="hint"> — @layer.Store.Paths.Count files · priority @(layerIndex + 1)</span></div>
                        <div class="package-actions">
                            <button type="button" @onclick="() => MovePackageAsync(layer, -1)" disabled="@(isLoading || layerIndex == 0)" aria-label="Move @layer.Name higher">Move up</button>
                            <button type="button" @onclick="() => MovePackageAsync(layer, 1)" disabled="@(isLoading || layerIndex == layers.Count - 1)" aria-label="Move @layer.Name lower">Move down</button>
                            <button type="button" @onclick="() => RemovePackageAsync(layer)" disabled="@isLoading" aria-label="Remove @layer.Name">Remove</button>
                        </div>
                    </li>
                }
            </ol>
            <h3>Resolved content namespace</h3>
            <ul class="path-list">
                @foreach (var path in (composite?.Paths ?? Array.Empty<string>()).Take(40))
                {
                    <li><code>@path</code><span class="hint"> — @composite!.GetSourcePackage(path)</span></li>
                }
            </ul>
            @if ((composite?.Paths.Count ?? 0) > 40)
            {
                <p class="hint">Showing the first 40 resolved paths.</p>
            }
            @if (consistCatalog is not null)
            {
                <h3>Train consists discovered</h3>
                <p class="hint">@consistCatalog.Consists.Count valid consist(s) · @consistCatalog.Issues.Count file issue(s) · @consistCatalog.CarAssets.Count(asset => asset.Found)/@consistCatalog.CarAssets.Count rolling-stock definitions resolved · @consistCatalog.CarAssets.Count(asset => asset.ShapeFound)/@consistCatalog.CarAssets.Count rolling-stock shapes resolved · @consistCatalog.TcsAssets.Count(asset => asset.Found)/@consistCatalog.TcsAssets.Count TCS scripts resolved</p>
                @foreach (var consist in consistCatalog.Consists)
                {
                    var tcsAsset = consistCatalog.TcsAssets.FirstOrDefault(asset => asset.ConsistName == consist.Name);
                    <details class="consist-entry">
                        <summary><strong>@consist.Name</strong> <span class="hint">— @consist.Cars.Count cars · @consist.SourcePath @(consist.SourcePackage is null ? "" : $"· {consist.SourcePackage}")</span></summary>
                        <dl>
                            <dt>Durability</dt><dd>@consist.Durability</dd>
                            <dt>Serial</dt><dd>@consist.Serial</dd>
                            <dt>Next wagon UID</dt><dd>@consist.NextWagonUid</dd>
                            @if (consist.MaxVelocity is not null)
                            {
                                <dt>Maximum velocity</dt><dd>@consist.MaxVelocity.A / @consist.MaxVelocity.B</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(consist.TrainControlSystemParametersFile))
                            {
                                <dt>Train-control parameters</dt><dd><code>@consist.TrainControlSystemParametersFile</code> — @(tcsAsset is null ? "unresolved" : tcsAsset.Found ? (tcsAsset.SourcePackage is null ? "found" : $"found in {tcsAsset.SourcePackage}") : "missing")</dd>
                            }
                        </dl>
                        <ol class="path-list">
                            @foreach (var car in consist.Cars)
                            {
                                var carAsset = consistCatalog.CarAssets.FirstOrDefault(asset => asset.ConsistName == consist.Name && asset.Uid == car.Uid);
                                <li>@(car.IsEngine ? "Engine" : car.IsEndOfTrain ? "EOT" : "Wagon"): @car.Name <span class="hint">(@car.Folder, UID @car.Uid@(car.Flipped ? ", flipped" : ""))</span>
                                    @if (carAsset is not null && !car.IsEndOfTrain)
                                    {
                                        <small class="hint">Shape: @(carAsset.Metadata?.ShapeFileName ?? "not declared") — @(carAsset.ShapeFound ? $"resolved from {carAsset.ShapeSourcePackage ?? "package"}" : carAsset.Metadata?.ShapeFileName is null ? "no shape reference" : "missing shape asset")</small>
                                        @if (carAsset.TractionMetadata is { } traction)
                                        {
                                            <small class="hint">Traction: max @traction.MaxForceNewtons.ToString("N0") N · continuous @traction.MaxContinuousForceNewtons.ToString("N0") N · max power @traction.MaxPowerWatts.ToString("N0") W · @(traction.TractionForceCurves is null ? "basic force model" : "original throttle/speed curve loaded")</small>
                                        }
                                    }
                                    @if (car.Loads is not null)
                                    {
                                        <ul>
                                            @foreach (var load in car.Loads)
                                            {
                                                <li>Load: @load.Name <span class="hint">(@load.Folder · @load.Position@(load.State is null ? "" : $" · {load.State}") · interpreted @load.ParsedPosition/@load.ParsedState)</span></li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ol>
                    </details>
                }
                @if (consistCatalog.Issues.Count > 0)
                {
                    <h4>Consist file diagnostics</h4>
                    <ul class="path-list">
                        @foreach (var issue in consistCatalog.Issues.Take(15))
                        {
                            <li><code>@issue.Path</code> — @issue.Message</li>
                        }
                    </ul>
                }
            }
        }
    </section>
</main>

@code {
    private readonly List<PackageLayer> layers = [];
    private readonly List<RouteChoice> routeChoices = [];
    private CompositeContentStore? composite;
    private RouteChoice? selectedRoute;
    private string? errorMessage;
    private bool isLoading;
    private bool selectedDefault;
    private bool isBuildingRoute;
    private string? routeBuildMessage;
    private RouteLoadResult? loadedRoute;
    private TrackNetworkRoute? traversedRoute;
    private ConsistCatalogResult? consistCatalog;
    private TrainConsistSimulationSetup? simulationSetup;
    private BrowserTrainDrivingController? drivingController;
    private TrainConsistMotionState? currentMotionState;
    private uint selectedTrackNodeIndex;
    private bool reverseRouteStart;
    private readonly Dictionary<int, uint> selectedBranchTrackNodeIndices = [];
    private string? selectedConsistName;
    private string? selectedActivityPath;
    private IReadOnlyList<string> ActivityChoices => selectedRoute is not null && composite is not null
        ? ActivityFileLocator.FindForRoute(composite.Paths, selectedRoute.MetadataFile)
        : Array.Empty<string>();

    private string SimulationSnapshotKey => string.Join("|",
        selectedRoute?.Metadata.RouteId ?? "no-route",
        SelectedConsist?.Name ?? "no-consist",
        selectedTrackNodeIndex,
        reverseRouteStart,
        string.Join(",", selectedBranchTrackNodeIndices.OrderBy(pair => pair.Key)
            .Select(pair => $"{pair.Key}:{pair.Value}")));

    private ConsistMetadata? SelectedConsist => consistCatalog?.Consists.FirstOrDefault(consist =>
        consist.Name == selectedConsistName) ?? consistCatalog?.Consists.FirstOrDefault();

    private int DavisResistanceCoverage => simulationSetup?.ResistanceParametersByCar.Count(parameters =>
        parameters.DavisA > 0 || parameters.DavisB > 0 || parameters.DavisC > 0) ?? 0;

    private int RatedCouplerLimitCount => simulationSetup?.CouplerForceLimits.Count(limit =>
        limit.MaximumCompressionNewtons < double.MaxValue || limit.MaximumTensionNewtons < double.MaxValue) ?? 0;

    private IReadOnlyList<TrackVectorPath> RouteStartOptions => loadedRoute is null
        ? Array.Empty<TrackVectorPath>()
        : new RouteStartVectorSelector().SelectNearest(
            loadedRoute.TrackNetwork, loadedRoute.Metadata.RouteStart, maximumResults: 100);

    private IReadOnlyList<TrackVectorPath> RouteBranchOptions
    {
        get
        {
            var network = loadedRoute?.TrackNetwork;
            var junctionNode = traversedRoute?.PendingJunctionNodeIndex;
            if (network is null || junctionNode is null)
                return Array.Empty<TrackVectorPath>();
            var visited = traversedRoute!.Segments
                .Select(segment => segment.Path.TrackNodeIndex)
                .ToHashSet();
            return network.VectorPaths
                .Where(path => !visited.Contains(path.TrackNodeIndex) &&
                    path.ConnectedNodeIndices.Count == 2 &&
                    path.ConnectedNodeIndices.Contains(junctionNode.Value))
                .OrderByDescending(path => path.LengthMeters)
                .ThenBy(path => path.TrackNodeIndex)
                .ToArray();
        }
    }

    private async Task SelectRouteBranch(ChangeEventArgs args)
    {
        if (traversedRoute?.PendingJunctionNodeIndex is not { } junctionNode)
            return;

        if (uint.TryParse(args.Value?.ToString(),
            System.Globalization.NumberStyles.None,
            System.Globalization.CultureInfo.InvariantCulture, out var nodeIndex))
        {
            if (RouteBranchOptions.All(path => path.TrackNodeIndex != nodeIndex))
                return;
            selectedBranchTrackNodeIndices[junctionNode] = nodeIndex;
        }
        else
        {
            selectedBranchTrackNodeIndices.Remove(junctionNode);
        }

        await RebuildConnectedRouteAsync();
    }

    private void SelectDefaultRoute()
    {
        selectedDefault = true;
        selectedRoute = null;
        selectedActivityPath = null;
        errorMessage = null;
        loadedRoute = null;
        traversedRoute = null;
        simulationSetup = null;
        drivingController = null;
        currentMotionState = null;
        selectedTrackNodeIndex = 0;
        reverseRouteStart = false;
        selectedBranchTrackNodeIndices.Clear();
        routeBuildMessage = null;
    }

    private async Task SelectRoute(RouteChoice route)
    {
        selectedRoute = route;
        selectedActivityPath = null;
        selectedDefault = false;
        errorMessage = null;
        await BuildRouteNetworkAsync(route);
    }

    private async Task BuildRouteNetworkAsync(RouteChoice route)
    {
        loadedRoute = null;
        traversedRoute = null;
        simulationSetup = null;
        drivingController = null;
        currentMotionState = null;
        selectedTrackNodeIndex = 0;
        reverseRouteStart = false;
        routeBuildMessage = null;
        isBuildingRoute = true;
        await Task.Yield();

        try
        {
            if (composite is null)
                throw new InvalidDataException("No route content package is loaded.");

            loadedRoute = new RouteLoader().Load(composite, route.MetadataFile, route.Metadata);
            var traversalStart = RouteStartOptions.FirstOrDefault();
            selectedTrackNodeIndex = traversalStart?.TrackNodeIndex ?? 0;
            reverseRouteStart = traversalStart is not null &&
                new RouteStartVectorSelector().IsStartReversed(
                    traversalStart, loadedRoute.Metadata.RouteStart);
            selectedBranchTrackNodeIndices.Clear();
            routeBuildMessage = $"Route track network built from {loadedRoute.Assets.TrackDatabasePath}.";
            BuildConnectedRoute();
        }
        catch (Exception exception)
        {
            routeBuildMessage = $"Route network could not be built: {exception.Message}";
        }
        finally
        {
            isBuildingRoute = false;
        }
    }

    private async Task SelectTrackStart(ChangeEventArgs args)
    {
        if (uint.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.None,
                System.Globalization.CultureInfo.InvariantCulture, out var trackNodeIndex))
        {
            selectedTrackNodeIndex = trackNodeIndex;
            selectedBranchTrackNodeIndices.Clear();
            await RebuildConnectedRouteAsync();
        }
    }

    private async Task SelectRouteDirection(ChangeEventArgs args)
    {
        reverseRouteStart = string.Equals(
            args.Value?.ToString(), "reverse", StringComparison.OrdinalIgnoreCase);
        selectedBranchTrackNodeIndices.Clear();
        await RebuildConnectedRouteAsync();
    }

    private async Task RebuildConnectedRouteAsync()
    {
        isBuildingRoute = true;
        await Task.Yield();
        try
        {
            BuildConnectedRoute();
        }
        finally
        {
            isBuildingRoute = false;
        }
    }

    private void BuildConnectedRoute()
    {
        if (loadedRoute is null)
        {
            traversedRoute = null;
            InitializeSimulationSetup();
            return;
        }

        try
        {
            traversedRoute = selectedTrackNodeIndex == 0
                ? null
                : new TrackNetworkRouteBuilder().Build(
                    loadedRoute.TrackNetwork, selectedTrackNodeIndex,
                    startReversed: reverseRouteStart,
                    preferredNextTrackNodeIndices: selectedBranchTrackNodeIndices);
            routeBuildMessage = $"Route track network built from {loadedRoute.Assets.TrackDatabasePath}." +
                (traversedRoute is null
                    ? " No two-ended vector path was available for connected traversal."
                    : $" Connected traversal followed {traversedRoute.Segments.Count} vector nodes.");
        }
        catch (Exception exception) when (exception is ArgumentException || exception is InvalidDataException)
        {
            traversedRoute = null;
            routeBuildMessage = $"Connected route traversal failed: {exception.Message}";
        }

        InitializeSimulationSetup();
    }

    private async Task HandleRouteZip(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        isLoading = true;
        routeChoices.Clear();
        selectedRoute = null;
        selectedActivityPath = null;
        selectedDefault = false;
        loadedRoute = null;
        traversedRoute = null;
        simulationSetup = null;
        drivingController = null;
        currentMotionState = null;
        selectedTrackNodeIndex = 0;
        reverseRouteStart = false;
        routeBuildMessage = null;

        try
        {
            var file = args.File;
            var store = await BrowserZipPackageLoader.LoadAsync(file);
            var packageName = GetUniquePackageName(file.Name);
            var layer = new PackageLayer(packageName, store);
            layers.Insert(0, layer);
            RebuildComposite();

            var routeFiles = store.Paths
                .Where(path => path.EndsWith(".trk", StringComparison.OrdinalIgnoreCase))
                .OrderBy(path => path, StringComparer.OrdinalIgnoreCase)
                .ToArray();

            if (routeFiles.Length == 0)
                throw new InvalidDataException("This ZIP has no .trk route metadata file.");

            foreach (var routeFile in routeFiles)
            {
                try
                {
                    var metadata = new RouteMetadataReader().Read(composite!, routeFile);
                    routeChoices.Add(new RouteChoice(metadata, packageName, routeFile));
                }
                catch (Exception exception) when (exception is InvalidDataException || exception is IOException || exception is ArgumentException)
                {
                    errorMessage = $"Could not parse '{routeFile}': {exception.Message}";
                }
            }

            if (routeChoices.Count == 0)
                throw new InvalidDataException(errorMessage ?? "No valid Tr_RouteFile metadata was found in this package.");

            if (routeChoices.Count == 1)
                await SelectRoute(routeChoices[0]);
        }
        catch (Exception exception) when (exception is IOException || exception is InvalidDataException || exception is ArgumentException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        isLoading = true;
        try
        {
            var selectedFiles = args.GetMultipleFiles(20);
            for (var i = selectedFiles.Count - 1; i >= 0; i--)
            {
                var file = selectedFiles[i];
                var store = await BrowserZipPackageLoader.LoadAsync(file);
                layers.Insert(0, new PackageLayer(GetUniquePackageName(file.Name), store));
            }
            RebuildComposite();
            if (selectedRoute is not null)
                await BuildRouteNetworkAsync(selectedRoute);
        }
        catch (Exception exception) when (exception is IOException || exception is InvalidDataException || exception is ArgumentException)
        {
            errorMessage = exception.Message;
            RebuildComposite();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetUniquePackageName(string fileName)
    {
        var name = fileName;
        var suffix = 2;
        while (layers.Any(layer => layer.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
            name = $"{fileName} ({suffix++})";
        return name;
    }

    private async Task MovePackageAsync(PackageLayer layer, int offset)
    {
        if (isLoading)
            return;

        var index = layers.IndexOf(layer);
        var targetIndex = index + offset;
        if (index < 0 || targetIndex < 0 || targetIndex >= layers.Count)
            return;

        layers.RemoveAt(index);
        layers.Insert(targetIndex, layer);
        RebuildComposite();

        if (selectedRoute is not null)
            await BuildRouteNetworkAsync(selectedRoute);
    }

    private async Task RemovePackageAsync(PackageLayer layer)
    {
        if (isLoading)
            return;

        var removedSelectedRoute = selectedRoute?.PackageName.Equals(layer.Name, StringComparison.OrdinalIgnoreCase) == true;
        layers.Remove(layer);
        layer.Store.Dispose();

        routeChoices.RemoveAll(route => route.PackageName.Equals(layer.Name, StringComparison.OrdinalIgnoreCase));
        if (removedSelectedRoute)
        {
            selectedRoute = null;
            loadedRoute = null;
            traversedRoute = null;
            selectedTrackNodeIndex = 0;
            reverseRouteStart = false;
            routeBuildMessage = null;
        }

        RebuildComposite();

        if (selectedRoute is not null)
            await BuildRouteNetworkAsync(selectedRoute);
    }

    private void RebuildComposite()
    {
        // The composite is only a view over package stores. Keep those stores alive
        // when changing precedence; removed packages are disposed explicitly.
        composite?.Dispose();
        composite = layers.Count == 0 ? null : new CompositeContentStore(layers, ownsStores: false);
        consistCatalog = composite is null ? null : new ConsistCatalogReader().Read(composite);
        if (consistCatalog?.Consists.Any(consist => consist.Name == selectedConsistName) != true)
            selectedConsistName = consistCatalog?.Consists.FirstOrDefault()?.Name;
        InitializeSimulationSetup();
    }

    private void InitializeSimulationSetup()
    {
        simulationSetup = null;
        drivingController = null;
        currentMotionState = null;
        var consist = SelectedConsist;
        if (consist is null || traversedRoute is null || traversedRoute.LengthMeters <= 0)
            return;
        try
        {
            simulationSetup = new TrainConsistSimulationSetupBuilder().Build(
                consist, consistCatalog!.CarAssets, traversedRoute.LengthMeters);
            drivingController = new BrowserTrainDrivingController(simulationSetup, route: traversedRoute);
            currentMotionState = simulationSetup.InitialState;
        }
        catch (ArgumentException exception)
        {
            routeBuildMessage = $"Simulation setup unavailable: {exception.Message}";
        }
    }

    private void SelectConsist(ChangeEventArgs args)
    {
        selectedConsistName = args.Value?.ToString();
        InitializeSimulationSetup();
    }

    private void SelectActivity(ChangeEventArgs args)
    {
        selectedActivityPath = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value.ToString();
    }

    private Task OnTrainMotionChanged(TrainConsistMotionState state)
    {
        currentMotionState = state;
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        composite?.Dispose();
        foreach (var layer in layers)
            layer.Store.Dispose();
    }

    private sealed record RouteChoice(RouteMetadata Metadata, string PackageName, string MetadataFile);
}
