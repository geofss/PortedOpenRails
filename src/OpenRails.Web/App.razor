@page "/"
@using OpenRails.Web.Content
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

<main class="shell">
    <p class="eyebrow">OPEN RAILS · WEB PORT</p>
    <h1>PortedOpenRails</h1>
    <p class="status">Browser content pipeline · Milestone 2D</p>
    <p class="note">
        Import multiple ZIP packages. Earlier packages have higher priority, so route-specific
        files can override global package files. Everything stays in this page's memory.
    </p>

    <section class="import-panel" aria-labelledby="import-heading">
        <h2 id="import-heading">Add content packages</h2>
        <InputFile OnChange="HandleFilesSelected" accept=".zip,application/zip"
                   multiple disabled="@isLoading" />
        <p class="hint">ZIP only · Maximum 256 MiB per package · First selected package gets highest priority</p>

        @if (isLoading)
        {
            <p class="status">Reading packages…</p>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="error" role="alert">@errorMessage</p>
        }

        @if (layers.Count > 0)
        {
            <div class="package-summary">
                <p class="success">@(layers.Count) package(s) loaded</p>
                <p>@(composite?.Paths.Count ?? 0) unique virtual files available</p>
            </div>

            <h3>Package priority</h3>
            <ol class="path-list">
                @foreach (var layer in layers)
                {
                    <li>
                        <strong>@layer.Name</strong>
                        <span class="hint"> — @layer.Store.Paths.Count files · priority @(@layers.IndexOf(layer) + 1)</span>
                    </li>
                }
            </ol>

            <h3>Resolved content namespace</h3>
            <ul class="path-list">
                @foreach (var path in (composite?.Paths ?? Array.Empty<string>()).Take(40))
                {
                    <li>
                        <code>@path</code>
                        <span class="hint"> — @composite!.GetSourcePackage(path)</span>
                    </li>
                }
            </ul>
            @if ((composite?.Paths.Count ?? 0) > 40)
            {
                <p class="hint">Showing the first 40 resolved paths.</p>
            }
        }
    </section>
</main>

@code {
    private readonly List<PackageLayer> layers = [];
    private CompositeContentStore? composite;
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleFilesSelected(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            foreach (var file in args.GetMultipleFiles(20))
            {
                var store = await BrowserZipPackageLoader.LoadAsync(file);
                var packageName = GetUniquePackageName(file.Name);\n                layers.Insert(0, new PackageLayer(packageName, store));
            }

            RebuildComposite();
        }
        catch (Exception exception) when (
            exception is IOException ||
            exception is InvalidDataException ||
            exception is ArgumentException)
        {
            errorMessage = exception.Message;
            RebuildComposite();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RebuildComposite()
    {
        composite?.Dispose();
        composite = layers.Count == 0 ? null : new CompositeContentStore(layers);
    }

    public void Dispose()
    {
        composite?.Dispose();
        if (composite is null)
        {
            foreach (var layer in layers)
                layer.Store.Dispose();
        }
    }
}
