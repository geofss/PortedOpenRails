    private IReadOnlyList<TrackVectorPath> RouteBranchOptions
    {
        get
        {
            var network = loadedRoute?.TrackNetwork;
            var junctionNode = traversedRoute?.PendingJunctionNodeIndex;
            if (network is null || junctionNode is null)
                return Array.Empty<TrackVectorPath>();
            var visited = traversedRoute!.Segments
                .Select(segment => segment.Path.TrackNodeIndex)
                .ToHashSet();
            return network.VectorPaths
                .Where(path => !visited.Contains(path.TrackNodeIndex) &&
                    path.ConnectedNodeIndices.Count == 2 &&
                    path.ConnectedNodeIndices.Contains(junctionNode.Value))
                .OrderByDescending(path => path.LengthMeters)
                .ThenBy(path => path.TrackNodeIndex)
                .ToArray();
        }
    }

    private async Task SelectRouteBranch(ChangeEventArgs args)
    {
        if (traversedRoute?.PendingJunctionNodeIndex is not { } junctionNode)
            return;

        if (uint.TryParse(args.Value?.ToString(),
            System.Globalization.NumberStyles.None,
            System.Globalization.CultureInfo.InvariantCulture, out var nodeIndex))
        {
            if (RouteBranchOptions.All(path => path.TrackNodeIndex != nodeIndex))
                return;
            selectedBranchTrackNodeIndices[junctionNode] = nodeIndex;
        }
        else
        {
            selectedBranchTrackNodeIndices.Remove(junctionNode);
        }

        await RebuildConnectedRouteAsync();
    }

