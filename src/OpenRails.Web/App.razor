    private async Task RebuildConnectedRouteAsync()
    {
        isBuildingRoute = true;
        await Task.Yield();
        try
        {
            BuildConnectedRoute();
        }
        finally
        {
            isBuildingRoute = false;
        }
    }

    private void BuildConnectedRoute()
    {
        if (loadedRoute is null)
        {
            traversedRoute = null;
            activityRouteProfile = null;
            InitializeSimulationSetup();
            return;
        }

        try
        {
            traversedRoute = selectedTrackNodeIndex == 0
                ? null
                : new TrackNetworkRouteBuilder().Build(
                    loadedRoute.TrackNetwork, selectedTrackNodeIndex,
                    startReversed: reverseRouteStart,
                    preferredNextTrackNodeIndices: selectedBranchTrackNodeIndices);
            activityRouteProfile = traversedRoute is null ? null : TrackNetworkRouteProfile.Build(traversedRoute);
            routeBuildMessage = $"Route track network built from {loadedRoute.Assets.TrackDatabasePath}." +
                (traversedRoute is null
                    ? " No two-ended vector path was available for connected traversal."
                    : $" Connected traversal followed {traversedRoute.Segments.Count} vector nodes.");
        }
        catch (Exception exception) when (exception is ArgumentException || exception is InvalidDataException)
        {
            traversedRoute = null;
            activityRouteProfile = null;
            routeBuildMessage = $"Connected route traversal failed: {exception.Message}";
        }

        InitializeSimulationSetup();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var preferencesJson = await JS.InvokeAsync<string?>("localStorage.getItem", BrowserPreferencesKey);
            if (!string.IsNullOrWhiteSpace(preferencesJson))
            {
                var preferences = System.Text.Json.JsonSerializer.Deserialize<BrowserUiPreferences>(preferencesJson);
                if (preferences is not null)
                {
                    loggingEnabled = preferences.LoggingEnabled;
                    browserAutosaveEnabled = preferences.AutosaveEnabled;
                    browserAutosaveMinutes = preferences.AutosaveMinutes is 15 or 30 or 60 ? preferences.AutosaveMinutes : 30;
                    browserAudioVolume = Math.Clamp(preferences.AudioVolume, 0, 100);
                    isActivityMode = preferences.ActivityMode;
                }
            }
        }
        catch (JSException)
        {
            // Browser storage may be unavailable; use safe defaults.
        }
        catch (System.Text.Json.JsonException)
        {
            // Ignore stale or malformed browser preference data.
        }

        try
        {
            storedPackages.AddRange(await BrowserPackageArchiveUploader.ListAsync(JS));
        }
        catch (JSException)
        {
            // OPFS may be unavailable or disabled; small in-memory route imports remain usable.
        }
    }

    private async Task IndexStoredPackageAsync(StoredBrowserPackage package)
    {
        isLoading = true;
        errorMessage = null;
        stagedRouteMetadata.Remove(package.Id);
        try
        {
            var index = await BrowserPackageArchiveIndexer.InspectAsync(JS, package.Id);
            indexedPackages[package.Id] = index;

            var parsedRoutes = new List<StagedRouteMetadata>();
            var rejectedRoutes = new List<string>();
            foreach (var routePath in index.RouteFiles)
            {
                try
                {
                    var metadata = await BrowserPackageRouteMetadataReader.ReadAsync(JS, package.Id, routePath);
                    parsedRoutes.Add(new StagedRouteMetadata(routePath, metadata));
                }
                catch (Exception exception) when (exception is JSException || exception is IOException ||
                    exception is InvalidDataException || exception is ArgumentException)
                {
                    rejectedRoutes.Add($"{routePath}: {exception.Message}");
                }
            }

            stagedRouteMetadata[package.Id] = parsedRoutes;
            largePackageMessage = $"Indexed {index.EntryCount:N0} files in {package.FileName}. " +
                $"Upstream STFReader successfully parsed {parsedRoutes.Count}/{index.RouteFiles.Count} route metadata file(s). " +
                "The archive remains disk-backed; full track, terrain, and scenery loading still needs the asynchronous content-store integration.";
            if (rejectedRoutes.Count > 0)
                errorMessage = string.Join(" | ", rejectedRoutes.Take(5));
        }
        catch (Exception exception) when (exception is JSException || exception is IOException || exception is InvalidDataException || exception is ArgumentException)
        {
            errorMessage = $"Could not index {package.FileName}: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadStagedRouteAsync(
        StoredBrowserPackage package,
        string routeFile,
        RouteMetadata metadata)
    {
        if (isLoading)
            return;

        isLoading = true;
        errorMessage = null;
        if (loadedStagedPackageNames.TryGetValue(package.Id, out var existingPackageName))
        {
            var existingRoute = routeChoices.FirstOrDefault(item =>
                item.PackageName.Equals(existingPackageName, StringComparison.OrdinalIgnoreCase) &&
                item.MetadataFile.Equals(routeFile, StringComparison.OrdinalIgnoreCase));
            if (existingRoute is null)
            {
                existingRoute = new RouteChoice(metadata, existingPackageName, VirtualPath.Normalize(routeFile));
                routeChoices.Add(existingRoute);
            }
            await SelectRoute(existingRoute);
            isLoading = false;
            return;
        }
        largePackageMessage = $"Loading {package.FileName} entry-by-entry from OPFS. The current synchronous Open Rails readers require a bounded expanded-content compatibility store (maximum 2 GiB).";
        try
        {
            if (indexedPackages.TryGetValue(package.Id, out var packageIndex) &&
                packageIndex.TotalUncompressedBytes > BrowserPackageVirtualContentStore.MaximumExpandedPackageBytes)
                throw new InvalidDataException(
                    $"Expanded archive size is {(packageIndex.TotalUncompressedBytes / (1024d * 1024 * 1024)):N2} GiB; " +
                    $"the current route-reader compatibility bridge is limited to " +
                    $"{BrowserPackageVirtualContentStore.MaximumExpandedPackageBytes / (1024d * 1024 * 1024):N0} GiB.");

            var progress = new Progress<(int Completed, int Total)>(value =>
            {
                _ = InvokeAsync(() =>
                {
                    largePackageMessage = $"Reading route package entries from OPFS: {value.Completed:N0}/{value.Total:N0}";
                    StateHasChanged();
                });
            });
            var store = await BrowserPackageVirtualContentStore.LoadAsync(JS, package.Id, progress);
            var packageName = GetUniquePackageName(package.FileName);
            layers.Insert(0, new PackageLayer(packageName, store));
            loadedStagedPackageNames[package.Id] = packageName;
            RebuildComposite();

            var route = new RouteChoice(metadata, packageName, VirtualPath.Normalize(routeFile));
            routeChoices.RemoveAll(item =>
                item.PackageName.Equals(packageName, StringComparison.OrdinalIgnoreCase) &&
                item.MetadataFile.Equals(route.MetadataFile, StringComparison.OrdinalIgnoreCase));
            routeChoices.Add(route);
            largePackageMessage = $"Loaded {store.Paths.Count:N0} route-package files into the browser content pipeline. Building the original route systems…";
            await SelectRoute(route);
        }
        catch (Exception exception) when (exception is IOException || exception is InvalidDataException ||
            exception is ArgumentException || exception is JSException || exception is OverflowException)
        {
            errorMessage = $"Could not load staged route: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static void DisposePackageStore(IVirtualContentStore store)
    {
        if (store is IDisposable disposable)
            disposable.Dispose();
    }

    private async Task DeleteStoredPackageAsync(StoredBrowserPackage package)
    {
        try
        {
            // If this OPFS package was already loaded, remove its in-memory content
            // layer first so deleting the staged file also releases route memory.
            if (loadedStagedPackageNames.TryGetValue(package.Id, out var packageName))
            {
                var loadedLayer = layers.FirstOrDefault(layer =>
                    layer.Name.Equals(packageName, StringComparison.OrdinalIgnoreCase));
                if (loadedLayer is not null)
                    await RemovePackageAsync(loadedLayer);
                else
                    loadedStagedPackageNames.Remove(package.Id);
            }

            await BrowserPackageArchiveUploader.DeleteAsync(JS, package.Id);
            storedPackages.RemoveAll(item => item.Id == package.Id);
            indexedPackages.Remove(package.Id);
            stagedRouteMetadata.Remove(package.Id);
            largePackageMessage = $"Deleted staged archive {package.FileName} and released its loaded route package.";
        }
        catch (JSException exception)
        {
            errorMessage = $"Could not delete the staged archive: {exception.Message}";
        }
    }

    private async Task HandleRouteZip(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        isLoading = true;
        routeChoices.Clear();
        selectedRoute = null;
        selectedActivityPath = null;
        selectedDefault = false;
        loadedRoute = null;
        traversedRoute = null;
        simulationSetup = null;
        drivingController = null;
        currentMotionState = null;
        selectedTrackNodeIndex = 0;
        reverseRouteStart = false;
        routeBuildMessage = null;

        try
        {
            var file = args.File;
            largePackageMessage = null;
            if (file.Size > BrowserZipPackageLoader.DefaultMaxArchiveBytes)
            {
                largeUploadInProgress = true;
                largeUploadBytes = 0;
                largeUploadTotalBytes = file.Size;
                largeUploadPercent = 0;
                var progress = new BrowserPackageUploadProgress((uploaded, total) =>
                {
                    _ = InvokeAsync(() =>
                    {
                        largeUploadBytes = uploaded;
                        largeUploadTotalBytes = total;
                        largeUploadPercent = total <= 0 ? 0 : (int)Math.Clamp(uploaded * 100d / total, 0, 100);
                        StateHasChanged();
                    });
                });
                using var progressReference = DotNetObjectReference.Create(progress);
                var stored = await BrowserPackageArchiveUploader.StoreAsync(JS, file, progressReference);
                storedPackages.RemoveAll(item => item.Id == stored.Id);
                storedPackages.Insert(0, stored);
                largePackageMessage = $"Uploaded {stored.FileName} ({(stored.SizeBytes / 1_000_000_000d):N2} GB) to browser OPFS storage. Persistent-storage protection: {(stored.PersistentStorageGranted ? "granted" : "not granted")}. Select Index ZIP contents, then Load route into simulator for supported packages.";
                return;
            }

            var store = await BrowserZipPackageLoader.LoadAsync(
                file,
                maxEntryBytes: BrowserPackageVirtualContentStore.MaximumEntryBytes,
                maxTotalBytes: BrowserPackageVirtualContentStore.MaximumExpandedPackageBytes);
            var packageName = GetUniquePackageName(file.Name);
            var layer = new PackageLayer(packageName, store);
            layers.Insert(0, layer);
            RebuildComposite();

            var routeFiles = store.Paths
                .Where(path => path.EndsWith(".trk", StringComparison.OrdinalIgnoreCase))
                .OrderBy(path => path, StringComparer.OrdinalIgnoreCase)
                .ToArray();

            if (routeFiles.Length == 0)
                throw new InvalidDataException("This ZIP has no .trk route metadata file.");

            foreach (var routeFile in routeFiles)
            {
                try
                {
                    var metadata = new RouteMetadataReader().Read(composite!, routeFile);
                    routeChoices.Add(new RouteChoice(metadata, packageName, routeFile));
                }
                catch (Exception exception) when (exception is InvalidDataException || exception is IOException || exception is ArgumentException)
                {
                    errorMessage = $"Could not parse '{routeFile}': {exception.Message}";
                }
            }

            if (routeChoices.Count == 0)
                throw new InvalidDataException(errorMessage ?? "No valid Tr_RouteFile metadata was found in this package.");

            if (routeChoices.Count == 1)
                await SelectRoute(routeChoices[0]);
        }
        catch (Exception exception) when (exception is IOException || exception is InvalidDataException || exception is ArgumentException || exception is JSException)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
            largeUploadInProgress = false;
        }
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs args)
    {
        errorMessage = null;
        isLoading = true;
        try
        {
            var selectedFiles = args.GetMultipleFiles(20);
            for (var i = selectedFiles.Count - 1; i >= 0; i--)
            {
                var file = selectedFiles[i];
                var store = await BrowserZipPackageLoader.LoadAsync(file);
                layers.Insert(0, new PackageLayer(GetUniquePackageName(file.Name), store));
            }
            RebuildComposite();
            if (selectedRoute is not null)
                await BuildRouteNetworkAsync(selectedRoute);
        }
        catch (Exception exception) when (exception is IOException || exception is InvalidDataException || exception is ArgumentException)
        {
            errorMessage = exception.Message;
            RebuildComposite();
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetUniquePackageName(string fileName)
    {
        var name = fileName;
        var suffix = 2;
        while (layers.Any(layer => layer.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
            name = $"{fileName} ({suffix++})";
        return name;
    }

    private async Task MovePackageAsync(PackageLayer layer, int offset)
    {
        if (isLoading)
            return;

        var index = layers.IndexOf(layer);
        var targetIndex = index + offset;
        if (index < 0 || targetIndex < 0 || targetIndex >= layers.Count)
            return;

        layers.RemoveAt(index);
        layers.Insert(targetIndex, layer);
        RebuildComposite();

        if (selectedRoute is not null)
            await BuildRouteNetworkAsync(selectedRoute);
    }

    private async Task RemovePackageAsync(PackageLayer layer)
    {
        if (isLoading)
            return;

        var removedSelectedRoute = selectedRoute?.PackageName.Equals(layer.Name, StringComparison.OrdinalIgnoreCase) == true;
        layers.Remove(layer);
        foreach (var stagedId in loadedStagedPackageNames.Where(pair =>
            pair.Value.Equals(layer.Name, StringComparison.OrdinalIgnoreCase)).Select(pair => pair.Key).ToArray())
            loadedStagedPackageNames.Remove(stagedId);
        DisposePackageStore(layer.Store);

        routeChoices.RemoveAll(route => route.PackageName.Equals(layer.Name, StringComparison.OrdinalIgnoreCase));
        if (removedSelectedRoute)
        {
            selectedRoute = null;
            loadedRoute = null;
            traversedRoute = null;
            selectedTrackNodeIndex = 0;
            reverseRouteStart = false;
            routeBuildMessage = null;
        }

        RebuildComposite();

        if (selectedRoute is not null)
            await BuildRouteNetworkAsync(selectedRoute);
    }

    private void RebuildComposite()
    {
        // The composite is only a view over package stores. Keep those stores alive
        // when changing precedence; removed packages are disposed explicitly.
        composite?.Dispose();
        composite = layers.Count == 0 ? null : new CompositeContentStore(layers, ownsStores: false);
        consistCatalog = composite is null ? null : new ConsistCatalogReader().Read(composite);
        if (consistCatalog?.Consists.Any(consist => consist.Name == selectedConsistName) != true)
            selectedConsistName = consistCatalog?.Consists.FirstOrDefault()?.Name;
        InitializeSimulationSetup();
    }

    private void InitializeSimulationSetup()
    {
        simulationSetup = null;
        drivingController = null;
        currentMotionState = null;
        selectedServiceRoutePlan = null;
        var serviceBinding = SelectedServiceBinding;
        var consist = serviceBinding?.Consist ?? SelectedConsist;
        if (consist is null || traversedRoute is null || traversedRoute.LengthMeters <= 0)
            return;
        try
        {
            var initialSpeed = activityStartingSpeedMetersPerSecond ??
                serviceBinding?.Service.InitialSpeedMetersPerSecond ?? 0;
            selectedServiceRoutePlan = serviceBinding is null
                ? null
                : ServiceRoutePositionResolver.Resolve(
                    serviceBinding.MainTrace!, activityRouteProfile ??
                    throw new InvalidDataException("The connected route has no usable position profile."),
                    path: serviceBinding.Path);
            var serviceStartDistance = selectedServiceRoutePlan?.DistanceMeters ?? 0;
            simulationSetup = new TrainConsistSimulationSetupBuilder().Build(
                consist, consistCatalog!.CarAssets, traversedRoute.LengthMeters,
                startDistanceMeters: serviceStartDistance,
                initialSpeedMetersPerSecond: initialSpeed);
            drivingController = new BrowserTrainDrivingController(simulationSetup, route: traversedRoute);
            currentMotionState = simulationSetup.InitialState;
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidDataException)
        {
            routeBuildMessage = $"Simulation setup unavailable: {exception.Message}";
        }
    }

    private void SelectConsist(ChangeEventArgs args)
    {
        selectedServicePath = null;
        selectedConsistName = args.Value?.ToString();
        InitializeSimulationSetup();
    }

    private void SelectService(ChangeEventArgs args)
    {
        selectedServicePath = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? null : args.Value.ToString();
        if (SelectedServiceBinding?.Consist is { } consist)
            selectedConsistName = consist.Name;
        InitializeSimulationSetup();
    }

    private void SelectActivity(ChangeEventArgs args)
    {
        selectedServicePath = null;
        var selectedValue = args.Value?.ToString();
        if (string.Equals(selectedValue, "__explore__", StringComparison.Ordinal))
        {
            isExploreMode = true;
            selectedActivityPath = null;
            selectedActivityMetadata = null;
            selectedActivityEvents = null;
            selectedActivityPassengerService = null;
            selectedActivityPassengerPlatformBinding = null;
            activityExecution = null;
            activityStationStopTracker = null;
            activityStationStopProgress = null;
            activityPathWarning = null;
            activityParseError = null;
            activityStartingSpeedMetersPerSecond = null;
            selectedExploreStart ??= ExploreStartChoices.FirstOrDefault();
            selectedExplorePathId ??= ExploreDestinationChoices.FirstOrDefault()?.PathId;
            InitializeSimulationSetup();
            return;
        }
        isExploreMode = false;
        selectedActivityPath = string.IsNullOrWhiteSpace(selectedValue) ? null : selectedValue;
        selectedActivityMetadata = null;
        selectedActivityEvents = null;
        selectedActivityPassengerService = null;
        selectedActivityPassengerPlatformBinding = null;
        activityExecution = null;
        activityStationStopTracker = null;
        activityStationStopProgress = null;
        activityPathWarning = null;
        activityParseError = null;
        activityStartingSpeedMetersPerSecond = null;
        InitializeSimulationSetup();
        lastActivitySimulationTime = drivingController?.SimulationTimeSeconds ?? 0;
        if (selectedActivityPath is null || composite is null)
            return;

        try
        {
            selectedActivityMetadata = new ActivityMetadataReader().Read(composite, selectedActivityPath);
            selectedActivityEvents = new ActivityEventReader().Read(composite, selectedActivityPath);
            selectedActivityPassengerService =
                new ActivityPassengerServiceReader().Read(composite, selectedActivityPath);
            if (selectedActivityPassengerService is not null && loadedRoute is not null)
                selectedActivityPassengerPlatformBinding = ActivityPassengerPlatformBinding.Bind(
                    selectedActivityPassengerService, loadedRoute.TrackDatabase);
            if (!string.Equals(selectedActivityMetadata.RouteId, selectedRoute?.Metadata.RouteId,
                    StringComparison.OrdinalIgnoreCase))
                activityParseError = $"Activity RouteID '{selectedActivityMetadata.RouteId}' does not match the selected route.";
            else
            {
                activityStartingSpeedMetersPerSecond = selectedActivityMetadata.StartingSpeedMetersPerSecond;
                activityExecution = new ActivityExecutionSession(selectedActivityEvents);
                var activityPath = loadedRoutePaths.FirstOrDefault(path =>
                    string.Equals(path.PathId, selectedActivityMetadata.PathId, StringComparison.OrdinalIgnoreCase));
                if (activityPath is not null)
                    activityStationStopTracker = new ActivityStationStopTracker(activityPath);
                else
                    activityPathWarning = $"Activity PathID '{selectedActivityMetadata.PathId}' was not found in the selected route; AllStops actions cannot be evaluated.";
                InitializeSimulationSetup();
                lastActivitySimulationTime = drivingController?.SimulationTimeSeconds ?? 0;
            }
        }
        catch (Exception exception) when (exception is IOException || exception is InvalidDataException ||
            exception is ArgumentException)
        {
            activityParseError = $"Could not parse activity header: {exception.Message}";
        }
    }

    private Task OnTrainMotionChanged(TrainConsistMotionState state)
    {
        currentMotionState = state;
        if (loadedRoute is not null && traversedRoute is not null && state.Cars.Count > 0)
        {
            var selectedConsistCars = SelectedConsist?.Cars.Where(car => !car.IsEndOfTrain).ToArray()
                ?? Array.Empty<ConsistCar>();
            var carOccupancies = state.Cars.Select((carState, index) =>
            {
                var consistCar = index < selectedConsistCars.Length ? selectedConsistCars[index] : null;
                var asset = consistCar is null ? null : consistCatalog?.CarAssets.FirstOrDefault(candidate =>
                    candidate.Uid == consistCar.Uid &&
                    string.Equals(candidate.CarName, consistCar.Name, StringComparison.OrdinalIgnoreCase));
                var declaredLength = asset?.Metadata?.LengthM ?? 0;
                var length = float.IsFinite(declaredLength) && declaredLength > 0 ? declaredLength : 10;
                return new TrainCarRouteOccupancy(carState.DistanceMeters, length);
            }).ToArray();
            var occupiedNodes = SignalOccupancyResolver.Resolve(traversedRoute, carOccupancies);
            var selectedBranches = selectedBranchTrackNodeIndices.ToDictionary(
                pair => checked((uint)pair.Key), pair => pair.Value);
            currentSignalIndications = loadedRoute.Signalling.Evaluate(occupiedNodes, selectedBranches, loadedRoute.SignalScripts);
        }
        else
        {
            currentSignalIndications = Array.Empty<RouteSignalIndication>();
        }
        if (activityExecution is not null && drivingController is not null)
        {
            var simulationTime = drivingController.SimulationTimeSeconds;
            var elapsed = Math.Max(0, simulationTime - lastActivitySimulationTime);
            lastActivitySimulationTime = simulationTime;
            if (elapsed > 0 && state.Cars.Count > 0)
                {
                    var leadCar = state.Cars[0];
                    var position = activityRouteProfile is null
                        ? null
                        : ActivityLocationResolver.Resolve(activityRouteProfile.Sample(leadCar.DistanceMeters).Position);
                    if (position is not null && activityStationStopTracker is not null)
                        activityStationStopProgress = activityStationStopTracker.Advance(
                            position.TileX, position.TileZ, position.X, position.Z, leadCar.SpeedMetersPerSecond);
                    activityExecution.Advance(elapsed, position is null
                        ? new ActivityPlayerState(leadCar.SpeedMetersPerSecond)
                        : new ActivityPlayerState(leadCar.SpeedMetersPerSecond,
                            position.TileX, position.TileZ, position.X, position.Z,
                            activityStationStopProgress?.StationStopReached ?? false,
                            activityStationStopProgress?.AllStopsCompleted ?? false));
                }
        }
        return Task.CompletedTask;
    }

    private void AcknowledgeActivityEvent()
    {
        activityExecution?.Acknowledge();
    }

    public void Dispose()
    {
        composite?.Dispose();
        foreach (var layer in layers)
            DisposePackageStore(layer.Store);
    }

    private sealed record BrowserUiPreferences(bool LoggingEnabled, bool AutosaveEnabled, int AutosaveMinutes, int AudioVolume, bool ActivityMode);
    private sealed record RouteChoice(RouteMetadata Metadata, string PackageName, string MetadataFile);
    private sealed record StagedRouteMetadata(string Path, RouteMetadata Metadata);
}
