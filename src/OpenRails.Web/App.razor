            selectedRoute?.MetadataFile ?? string.Empty)
            .Select(path =>
            {
                try { return new RoutePathFileReader().Read(composite!, path); }
                catch (Exception exception) when (exception is InvalidDataException or IOException or ArgumentException)
                {
                    routeDiagnostics.Add($"Path {path}: {exception.Message}");
