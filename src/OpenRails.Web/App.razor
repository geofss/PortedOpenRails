    private bool selectedDefault;
    private bool isBuildingRoute;
    private string? routeBuildMessage;
    private RouteLoadResult? loadedRoute;
    private TrackNetworkRoute? traversedRoute;
    private TrackNetworkRouteProfile? activityRouteProfile;
    private ConsistCatalogResult? consistCatalog;
    private TrainConsistSimulationSetup? simulationSetup;
    private BrowserTrainDrivingController? drivingController;
    private TrainConsistMotionState? currentMotionState;
    private IReadOnlyList<RouteSignalIndication> currentSignalIndications = Array.Empty<RouteSignalIndication>();
    private uint selectedTrackNodeIndex;
    private bool reverseRouteStart;
    private readonly Dictionary<int, uint> selectedBranchTrackNodeIndices = [];
    private string? selectedConsistName;
    private string? selectedActivityPath;
    private IReadOnlyList<string> serviceChoices = Array.Empty<string>();
    private IReadOnlyList<ServiceMetadata> loadedServices = Array.Empty<ServiceMetadata>();
    private IReadOnlyList<string> availableRoutePathIds = Array.Empty<string>();
    private IReadOnlyList<RoutePathDefinition> loadedRoutePaths = Array.Empty<RoutePathDefinition>();
    private ActivityMetadata? selectedActivityMetadata;
