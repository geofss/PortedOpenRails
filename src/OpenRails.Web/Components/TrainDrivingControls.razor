@using OpenRails.Web.Simulation
@using OpenRails.Web.Parsing
@implements IAsyncDisposable

<section class="route-details driving-controls">
    <h3>Train driving controls</h3>
    <p class="hint">Prototype controls · fixed-step traction, braking, and automatic coupler force distribution</p>
    <div class="driving-control-row">
        <label for="train-throttle">Throttle · @Controller.ThrottlePercent.ToString("N0")%</label>
        <input id="train-throttle" type="range" min="0" max="100" step="1"
               value="@Controller.ThrottlePercent" @oninput="ChangeThrottle" />
    </div>
    <div class="driving-control-row">
        <label for="train-brake">Brake · @Controller.BrakePercent.ToString("N0")%</label>
        <input id="train-brake" type="range" min="0" max="100" step="1"
               value="@Controller.BrakePercent" @oninput="ChangeBrake" />
    </div>
    @if (!string.IsNullOrWhiteSpace(simulationError))
    {
        <p class="error" role="alert">@simulationError</p>
    }
    <div class="package-actions">
        <button type="button" @onclick="StartAsync" disabled="@isRunning">Start</button>
        <button type="button" @onclick="StopAsync" disabled="@(!isRunning)">Pause</button>
        <button type="button" @onclick="ResetAsync">Reset</button>
    </div>
    @if (Consist is not null)
    {
        <h4>Vehicle telemetry</h4>
        <div class="table-scroll">
            <table>
                <thead><tr><th>Vehicle</th><th>Speed</th><th>Route position</th><th>Brake-pipe pressure</th><th>Brake-cylinder pressure</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Controller.State.Cars.Count && i < DrivingCars.Count; i++)
                    {
                        var car = Controller.State.Cars[i];
                        <tr>
                            <td>@DrivingCars[i].Name</td>
                            <td>@((car.SpeedMetersPerSecond * 3.6).ToString("N1")) km/h</td>
                            <td>@car.DistanceMeters.ToString("N1") m</td>
                            <td>@Controller.BrakePipeState.PressuresKPa[i].ToString("N0") kPa</td>
                            <td>@Controller.BrakeCylinderState.PressuresKPa[i].ToString("N0") kPa</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Controller.CouplerForceTelemetryNewtons.Count > 0 && Consist is not null)
    {
        <h4>Coupler force telemetry</h4>
        <div class="table-scroll">
            <table>
                <thead><tr><th>Boundary</th><th>Force</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Controller.CouplerForceTelemetryNewtons.Count && i + 1 < DrivingCars.Count; i++)
                    {
                        <tr><td>@DrivingCars[i].Name ↔ @DrivingCars[i + 1].Name</td><td>@Controller.CouplerForceTelemetryNewtons[i].ToString("N0") N</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <dl>
        <dt>Train speed</dt><dd>@(speedKmh.ToString("N1")) km/h</dd>
        @if (Controller.LeadCarRouteGradePercent is double gradePercent)
        {
            <dt>Track grade · lead car</dt><dd>@gradePercent.ToString("N2")%</dd>
        }
        <dt>Brake pipe · front / rear</dt><dd>@Controller.BrakePipeState.PressuresKPa[0].ToString("N0") / @Controller.BrakePipeState.PressuresKPa[^1].ToString("N0") kPa</dd>
        <dt>Brake cylinder · front / rear</dt><dd>@Controller.BrakeCylinderState.PressuresKPa[0].ToString("N0") / @Controller.BrakeCylinderState.PressuresKPa[^1].ToString("N0") kPa</dd>
        <dt>Simulation time</dt><dd>@Controller.SimulationTimeSeconds.ToString("N1") s</dd>
        <dt>Physics state</dt><dd>@(isRunning ? "Running" : Controller.IsPaused ? "Paused" : "Ready")</dd>
    </dl>
</section>

@code {
    [Parameter, EditorRequired] public BrowserTrainDrivingController Controller { get; set; } = default!;
    [Parameter] public ConsistMetadata? Consist { get; set; }
    private IReadOnlyList<ConsistCar> DrivingCars => Consist?.Cars.Where(car => !car.IsEndOfTrain).ToArray() ?? Array.Empty<ConsistCar>();
    [Parameter] public EventCallback<TrainConsistMotionState> MotionChanged { get; set; }

    private CancellationTokenSource? runCancellation;
    private Task? runTask;
    private bool isRunning;
    private string? simulationError;
    private double speedKmh => Controller.State.Cars.Count == 0
        ? 0
        : Controller.State.Cars[0].SpeedMetersPerSecond * 3.6;

    private void ChangeThrottle(ChangeEventArgs args)
    {
        if (float.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
            Controller.SetThrottle(value);
    }

    private void ChangeBrake(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
            Controller.SetBrake(value);
    }

    private Task StartAsync()
    {
        if (isRunning)
            return Task.CompletedTask;
        simulationError = null;
        runCancellation = new CancellationTokenSource();
        Controller.Resume();
        isRunning = true;
        runTask = RunLoopAsync(runCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RunLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
        var previousTimestamp = System.Diagnostics.Stopwatch.GetTimestamp();
        var frameCount = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var currentTimestamp = System.Diagnostics.Stopwatch.GetTimestamp();
                var elapsed = (currentTimestamp - previousTimestamp) /
                    (double)System.Diagnostics.Stopwatch.Frequency;
                previousTimestamp = currentTimestamp;
                Controller.Advance(Math.Clamp(elapsed, 0, 0.25));
                frameCount++;
                if (frameCount % 2 == 0)
                {
                    await InvokeAsync(async () =>
                    {
                        await MotionChanged.InvokeAsync(Controller.State);
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception exception)
        {
            Controller.Pause();
            isRunning = false;
            simulationError = $"Simulation paused: {exception.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopAsync()
    {
        Controller.Pause();
        isRunning = false;
        var cancellation = runCancellation;
        runCancellation = null;
        cancellation?.Cancel();
        if (runTask is not null)
        {
            try { await runTask; } catch (OperationCanceledException) { }
            runTask = null;
        }
        cancellation?.Dispose();
    }

    private async Task ResetAsync()
    {
        await StopAsync();
        Controller.Reset();
        await MotionChanged.InvokeAsync(Controller.State);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await StopAsync();
    }
}
