@using OpenRails.Web.Simulation
@using OpenRails.Web.Parsing
@using Microsoft.JSInterop
@using System.Text.Json
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="route-details driving-controls">
    <h3>Train driving controls</h3>
    <p class="hint">Prototype controls · fixed-step traction, pneumatic braking, and dynamic coupler forces</p>
    <div class="driving-control-row">
        <label for="train-throttle">Throttle · @Controller.ThrottlePercent.ToString("N0")%</label>
        <input id="train-throttle" type="range" min="0" max="100" step="1"
               value="@Controller.ThrottlePercent" disabled="@(Controller.LeftDoorsOpen || Controller.RightDoorsOpen)" @oninput="ChangeThrottle" />
    </div>
    <div class="driving-control-row">
        <label for="train-reverser">Reverser · @(Controller.CanChangeReverser ? "available" : "stop train and set throttle to zero")</label>
        <select id="train-reverser" value="@((int)Controller.ReverserPosition)" disabled="@(!Controller.CanChangeReverser)" @onchange="ChangeReverser">
            <option value="1">Forward</option>
            <option value="0">Neutral</option>
            <option value="-1">Reverse</option>
        </select>
    </div>
    <div class="driving-control-row">
        <label for="train-brake">Brake · @Controller.BrakePercent.ToString("N0")%</label>
        <input id="train-brake" type="range" min="0" max="100" step="1"
               value="@Controller.BrakePercent" @oninput="ChangeBrake" />
    </div>
    <p class="hint">Gamepad: right trigger throttle, left trigger brake, D-pad up/down/left for forward/reverse/neutral, left/right shoulder buttons toggle left/right doors, south face button applies emergency stop, east face button explicitly releases it (standard mapping). If the controller disconnects while driving, throttle is cut and full brake is applied.</p>
    <div class="driving-settings" aria-label="Driving settings">
        <h4>Driving settings</h4>
        <div class="driving-control-row">
            <label for="driving-audio-volume">Synthesized audio volume · @audioVolume%</label>
            <input id="driving-audio-volume" type="range" min="0" max="100" step="5" value="@audioVolume" @oninput="ChangeAudioVolume" />
        </div>
        <div class="driving-control-row">
            <label for="gamepad-sensitivity">Gamepad trigger sensitivity · @gamepadSensitivity%</label>
            <input id="gamepad-sensitivity" type="range" min="50" max="150" step="5" value="@gamepadSensitivity" @oninput="ChangeGamepadSensitivity" />
        </div>
        <button type="button" @onclick="ResetDrivingSettings">Reset driving settings</button>
        <p class="hint">These preferences are saved on this device. Trigger sensitivity changes throttle/brake response curves; audio volume scales the optional synthesized sound.</p>
    </div>
    <button type="button" @onclick="ToggleAudioAsync">@((audioEnabled) ? "Disable synthesized driving audio" : "Enable synthesized driving audio")</button>
    <p class="hint">Optional low-volume original synthesis: engine tone follows throttle/speed and brake hiss follows brake pressure. Enable with a button press; not authentic Open Rails recordings.</p>
    <div class="keyboard-control-pad" tabindex="0" role="group"
         aria-label="Keyboard driving controls"
         @onkeydown="HandleKeyboardControl" @onkeydown:preventDefault="true">
        <strong>Keyboard controls</strong>
        <span>Focus here, then use ↑ / ↓ to adjust throttle, Space to toggle full brake, R / N / F for reverser, L / K to toggle left / right doors while stopped, or Esc to release throttle and brake; X applies emergency stop; Z explicitly releases it.</span>
        <span class="keyboard-control-state">Throttle @Controller.ThrottlePercent.ToString("N0")% · Brake @Controller.BrakePercent.ToString("N0")%</span>
    </div>
    @if (!string.IsNullOrWhiteSpace(simulationError))
    {
        <p class="error" role="alert">@simulationError</p>
    }
    <div class="package-actions">
        <button type="button" @onclick="SaveSimulationSnapshotAsync">Save simulation</button>
        <button type="button" @onclick="RestoreSimulationSnapshotAsync" disabled="@(!hasSavedSnapshot)">Restore saved simulation</button>
        <button type="button" @onclick="ClearSimulationSnapshotAsync" disabled="@(!hasSavedSnapshot)">Delete saved simulation</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(snapshotMessage))
    {
        <p class="@(snapshotError ? "error" : "hint")" role="status">@snapshotMessage</p>
    }
    <div class="package-actions">
        <button type="button" @onclick="ToggleLeftDoors" disabled="@(!Controller.CanOpenDoors && !Controller.LeftDoorsOpen)">@(Controller.LeftDoorsOpen ? "Close left doors" : "Open left doors")</button>
        <button type="button" @onclick="ToggleRightDoors" disabled="@(!Controller.CanOpenDoors && !Controller.RightDoorsOpen)">@(Controller.RightDoorsOpen ? "Close right doors" : "Open right doors")</button>
        <button type="button" class="danger" @onclick="ApplyEmergencyStop" disabled="@Controller.IsEmergencyStopApplied">Emergency stop</button>
        <button type="button" @onclick="ReleaseEmergencyStop" disabled="@(!Controller.IsEmergencyStopApplied)">Release emergency stop</button>
        <button type="button" @onclick="StartAsync" disabled="@isRunning">Start</button>
        <button type="button" @onclick="StopAsync" disabled="@(!isRunning)">Pause</button>
        <button type="button" @onclick="ResetAsync">Reset</button>
    </div>
    @if (Consist is not null)
    {
        <h4>Vehicle telemetry</h4>
        <div class="table-scroll">
            <table>
                <thead><tr><th>Vehicle</th><th>Speed</th><th>Route position</th><th>Track grade</th><th>Brake-pipe pressure</th><th>Brake-cylinder pressure</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Controller.State.Cars.Count && i < DrivingCars.Count; i++)
                    {
                        var car = Controller.State.Cars[i];
                        <tr>
                            <td>@DrivingCars[i].Name</td>
                            <td>@((car.SpeedMetersPerSecond * 3.6).ToString("N1")) km/h</td>
                            <td>@car.DistanceMeters.ToString("N1") m</td>
                            <td>@(Controller.RouteGradePercentByCar.Count > i ? Controller.RouteGradePercentByCar[i].ToString("N2") + "%" : "—")</td>
                            <td>@Controller.BrakePipeState.PressuresKPa[i].ToString("N0") kPa</td>
                            <td>@Controller.BrakeCylinderState.PressuresKPa[i].ToString("N0") kPa</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Controller.CouplerForceTelemetryNewtons.Count > 0 && Consist is not null)
    {
        <h4>Coupler force telemetry</h4>
        <div class="table-scroll">
            <table>
                <thead><tr><th>Boundary</th><th>Force</th><th>State</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Controller.CouplerForceTelemetryNewtons.Count && i + 1 < DrivingCars.Count; i++)
                    {
                        <tr>
                            <td>@DrivingCars[i].Name ↔ @DrivingCars[i + 1].Name</td>
                            <td>@Controller.CouplerForceTelemetryNewtons[i].ToString("N0") N</td>
                            <td>@(Controller.CouplerForceTelemetryNewtons[i] < 0 ? "Tension" : Controller.CouplerForceTelemetryNewtons[i] > 0 ? "Compression" : "Neutral")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <dl>
        <dt>Passenger doors</dt><dd>Left: @(Controller.LeftDoorsOpen ? "Open" : "Closed") · Right: @(Controller.RightDoorsOpen ? "Open" : "Closed")</dd>
        <dt>Train speed</dt><dd>@(speedKmh.ToString("N1")) km/h</dd>
        @if (Controller.LeadCarRouteGradePercent is double gradePercent)
        {
            <dt>Track grade · lead car</dt><dd>@gradePercent.ToString("N2")%</dd>
        }
        <dt>Brake pipe · front / rear</dt><dd>@Controller.BrakePipeState.PressuresKPa[0].ToString("N0") / @Controller.BrakePipeState.PressuresKPa[^1].ToString("N0") kPa</dd>
        <dt>Brake cylinder · front / rear</dt><dd>@Controller.BrakeCylinderState.PressuresKPa[0].ToString("N0") / @Controller.BrakeCylinderState.PressuresKPa[^1].ToString("N0") kPa</dd>
        <dt>Simulation time</dt><dd>@Controller.SimulationTimeSeconds.ToString("N1") s</dd>
        <dt>Dropped frame time</dt><dd>@Controller.DroppedTimeSeconds.ToString("N2") s</dd>
        <dt>Physics state</dt><dd>@(isRunning ? "Running" : Controller.IsPaused ? "Paused" : "Ready")</dd>
    </dl>
</section>

@code {
    [Parameter, EditorRequired] public BrowserTrainDrivingController Controller { get; set; } = default!;
    [Parameter] public ConsistMetadata? Consist { get; set; }
    private IReadOnlyList<ConsistCar> DrivingCars => Consist?.Cars.Where(car => !car.IsEndOfTrain).ToArray() ?? Array.Empty<ConsistCar>();
    [Parameter] public EventCallback<TrainConsistMotionState> MotionChanged { get; set; }

    private IJSObjectReference? gamepadModule;
    private IJSObjectReference? audioModule;
    private bool audioEnabled;
    private int audioVolume = 35;
    private int gamepadSensitivity = 100;
    private IJSObjectReference? settingsModule;
    private IJSObjectReference? snapshotStorageModule;
    private bool hasSavedSnapshot;
    private string? snapshotMessage;
    private bool snapshotError;
    private string SnapshotKey => (Consist?.Name ?? "unknown") + ":" + Controller.State.Cars.Count;
    private bool gamepadConnected;
    private bool previousForwardPressed;
    private bool previousReversePressed;
    private bool previousNeutralPressed;
    private bool previousEmergencyStopPressed;
    private bool previousEmergencyReleasePressed;
    private bool previousLeftDoorTogglePressed;
    private bool previousRightDoorTogglePressed;
    private CancellationTokenSource? runCancellation;
    private Task? runTask;
    private bool isRunning;
    private string? simulationError;
    private double speedKmh => Controller.State.Cars.Count == 0
        ? 0
        : Controller.State.Cars[0].SpeedMetersPerSecond * 3.6;

    private void ChangeThrottle(ChangeEventArgs args)
    {
        if (float.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
            Controller.SetThrottle(value);
    }

    private void ChangeReverser(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value) && value is >= -1 and <= 1)
            ApplyReverser((TrainReverserPosition)value);
    }

    private void ApplyReverser(TrainReverserPosition position)
    {
        try
        {
            Controller.SetReverser(position);
            simulationError = null;
        }
        catch (InvalidOperationException exception)
        {
            simulationError = exception.Message;
        }
    }

    private void ChangeBrake(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
            Controller.SetBrake(value);
    }

    private void HandleKeyboardControl(KeyboardEventArgs args)
    {
        if (args.Repeat)
            return;

        switch (args.Key)
        {
            case "ArrowUp":
                Controller.SetThrottle(Math.Min(100, Controller.ThrottlePercent + 5));
                break;
            case "ArrowDown":
                Controller.SetThrottle(Math.Max(0, Controller.ThrottlePercent - 5));
                break;
            case " ":
            case "Spacebar":
                Controller.SetBrake(Controller.BrakePercent >= 100 ? 0 : 100);
                break;
            case "f":
            case "F":
                ApplyReverser(TrainReverserPosition.Forward);
                break;
            case "n":
            case "N":
                ApplyReverser(TrainReverserPosition.Neutral);
                break;
            case "r":
            case "R":
                ApplyReverser(TrainReverserPosition.Reverse);
                break;
            case "Escape":
                Controller.SetThrottle(0);
                Controller.SetBrake(0);
                break;
            case "l":
            case "L":
                ToggleLeftDoors();
                break;
            case "k":
            case "K":
                ToggleRightDoors();
                break;
            case "x":
            case "X":
                ApplyEmergencyStop();
                break;
            case "z":
            case "Z":
                ReleaseEmergencyStop();
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                gamepadModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/train-driving-gamepad.js");
                audioModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/train-driving-audio.js");
                settingsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/train-driving-settings.js");
                snapshotStorageModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/train-simulation-storage.js");
                var storedSnapshot = await snapshotStorageModule.InvokeAsync<string?>("loadSnapshot", SnapshotKey);
                hasSavedSnapshot = !string.IsNullOrWhiteSpace(storedSnapshot);
                var savedSettings = await settingsModule.InvokeAsync<DrivingSettings>("loadSettings");
                audioVolume = savedSettings.AudioVolume;
                gamepadSensitivity = savedSettings.GamepadSensitivity;
                await audioModule.InvokeVoidAsync("setVolume", audioVolume / 100d);
            }
            catch (JSException)
            {
                // The controls remain usable through keyboard and pointer when gamepad APIs are unavailable.
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PollGamepadAsync()
    {
        if (gamepadModule is null)
            return;

        TrainGamepadState? state;
        try
        {
            state = await gamepadModule.InvokeAsync<TrainGamepadState?>("readState", gamepadSensitivity / 100d);
        }
        catch (JSException)
        {
            return;
        }

        if (state is null)
        {
            if (gamepadConnected)
            {
                Controller.SetThrottle(0);
                Controller.SetBrake(100);
                gamepadConnected = false;
            }
            previousForwardPressed = previousReversePressed = previousNeutralPressed = false;
            previousEmergencyStopPressed = previousEmergencyReleasePressed = false;
            previousLeftDoorTogglePressed = previousRightDoorTogglePressed = false;
            return;
        }

        gamepadConnected = true;
        Controller.SetThrottle((float)Math.Clamp(state.Throttle * 100, 0, 100));
        Controller.SetBrake(Math.Clamp(state.Brake * 100, 0, 100));
        if (state.ForwardPressed && !previousForwardPressed)
            ApplyReverser(TrainReverserPosition.Forward);
        if (state.ReversePressed && !previousReversePressed)
            ApplyReverser(TrainReverserPosition.Reverse);
        if (state.NeutralPressed && !previousNeutralPressed)
            ApplyReverser(TrainReverserPosition.Neutral);
        if (state.EmergencyStopPressed && !previousEmergencyStopPressed)
            ApplyEmergencyStop();
        if (state.EmergencyReleasePressed && !previousEmergencyReleasePressed)
            ReleaseEmergencyStop();
        if (state.LeftDoorTogglePressed && !previousLeftDoorTogglePressed)
            ToggleLeftDoors();
        if (state.RightDoorTogglePressed && !previousRightDoorTogglePressed)
            ToggleRightDoors();
        previousForwardPressed = state.ForwardPressed;
        previousReversePressed = state.ReversePressed;
        previousNeutralPressed = state.NeutralPressed;
        previousEmergencyStopPressed = state.EmergencyStopPressed;
        previousEmergencyReleasePressed = state.EmergencyReleasePressed;
        previousLeftDoorTogglePressed = state.LeftDoorTogglePressed;
        previousRightDoorTogglePressed = state.RightDoorTogglePressed;
    }

    private sealed class DrivingSettings { public int AudioVolume { get; set; } = 35; public int GamepadSensitivity { get; set; } = 100; }

    private async Task ChangeAudioVolume(ChangeEventArgs args) { if (!int.TryParse(args.Value?.ToString(), out var value)) return; audioVolume = Math.Clamp(value, 0, 100); if (audioModule is not null) await audioModule.InvokeVoidAsync("setVolume", audioVolume / 100d); await SaveSettingsAsync(); }
    private async Task ChangeGamepadSensitivity(ChangeEventArgs args) { if (!int.TryParse(args.Value?.ToString(), out var value)) return; gamepadSensitivity = Math.Clamp(value, 50, 150); await SaveSettingsAsync(); }
    private async Task ResetDrivingSettings() { audioVolume = 35; gamepadSensitivity = 100; if (audioModule is not null) await audioModule.InvokeVoidAsync("setVolume", audioVolume / 100d); await SaveSettingsAsync(); }
    private async Task SaveSettingsAsync()
    {
        if (settingsModule is null) return;
        try
        {
            var saved = await settingsModule.InvokeAsync<bool>("saveSettings", audioVolume, gamepadSensitivity);
            simulationError = saved ? null : "Browser storage is unavailable; these preferences will not persist.";
        }
        catch (JSException)
        {
            simulationError = "Driving preferences could not be saved in this browser.";
        }
    }

    private sealed class TrainGamepadState
    {
        public double Throttle { get; set; }
        public double Brake { get; set; }
        public bool ForwardPressed { get; set; }
        public bool ReversePressed { get; set; }
        public bool NeutralPressed { get; set; }
        public bool EmergencyStopPressed { get; set; }
        public bool EmergencyReleasePressed { get; set; }
        public bool LeftDoorTogglePressed { get; set; }
        public bool RightDoorTogglePressed { get; set; }
    }

    private async Task SaveSimulationSnapshotAsync()
    {
        if (snapshotStorageModule is null) { snapshotError = true; snapshotMessage = "Simulation storage is unavailable in this browser."; return; }
        try
        {
            var json = JsonSerializer.Serialize(Controller.CaptureState());
            hasSavedSnapshot = await snapshotStorageModule.InvokeAsync<bool>("saveSnapshot", SnapshotKey, json);
            snapshotError = !hasSavedSnapshot;
            snapshotMessage = hasSavedSnapshot ? "Simulation saved on this device. Import the same route and select the same consist to restore it." : "Browser storage is unavailable or full; the simulation was not saved.";
        }
        catch (Exception exception) when (exception is JSException || exception is JsonException)
        { snapshotError = true; snapshotMessage = $"Simulation could not be saved: {exception.Message}"; }
    }

    private async Task RestoreSimulationSnapshotAsync()
    {
        if (snapshotStorageModule is null) { snapshotError = true; snapshotMessage = "Simulation storage is unavailable in this browser."; return; }
        await StopAsync();
        try
        {
            var json = await snapshotStorageModule.InvokeAsync<string?>("loadSnapshot", SnapshotKey);
            if (string.IsNullOrWhiteSpace(json)) { hasSavedSnapshot = false; snapshotError = true; snapshotMessage = "No saved simulation was found for this consist."; return; }
            var snapshot = JsonSerializer.Deserialize<BrowserTrainDrivingControllerSnapshot>(json) ?? throw new JsonException("The saved simulation was empty.");
            Controller.RestoreState(snapshot);
            hasSavedSnapshot = true; snapshotError = false; snapshotMessage = "Saved simulation restored successfully.";
            await MotionChanged.InvokeAsync(Controller.State);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) when (exception is JSException || exception is JsonException || exception is ArgumentException || exception is InvalidOperationException)
        { snapshotError = true; snapshotMessage = $"Saved simulation was rejected: {exception.Message}"; }
    }

    private async Task ClearSimulationSnapshotAsync()
    {
        if (snapshotStorageModule is null) return;
        hasSavedSnapshot = !await snapshotStorageModule.InvokeAsync<bool>("clearSnapshot", SnapshotKey);
        snapshotError = hasSavedSnapshot;
        snapshotMessage = hasSavedSnapshot ? "The saved simulation could not be deleted from browser storage." : "Saved simulation deleted.";
    }

    private async Task ToggleAudioAsync()
    {
        if (audioModule is null)
        {
            try { audioModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/train-driving-audio.js"); }
            catch (JSException) { simulationError = "Synthesized audio is unavailable in this browser."; return; }
        }

        try
        {
            if (!audioEnabled)
            {
                await audioModule.InvokeVoidAsync("start");
                audioEnabled = true;
            }
            else
            {
                await audioModule.InvokeVoidAsync("setEnabled", false);
                audioEnabled = false;
            }
            simulationError = null;
        }
        catch (JSException exception)
        {
            simulationError = $"Audio could not be enabled: {exception.Message}";
            audioEnabled = false;
        }
    }

    private void ToggleLeftDoors()
    {
        try { Controller.SetDoors(!Controller.LeftDoorsOpen, Controller.RightDoorsOpen); simulationError = null; }
        catch (InvalidOperationException exception) { simulationError = exception.Message; }
    }

    private void ToggleRightDoors()
    {
        try { Controller.SetDoors(Controller.LeftDoorsOpen, !Controller.RightDoorsOpen); simulationError = null; }
        catch (InvalidOperationException exception) { simulationError = exception.Message; }
    }

    private void ApplyEmergencyStop()
    {
        Controller.ApplyEmergencyStop();
        simulationError = null;
    }

    private void ReleaseEmergencyStop()
    {
        Controller.ReleaseEmergencyStop();
        simulationError = null;
    }

    private Task StartAsync()
    {
        if (isRunning)
            return Task.CompletedTask;
        simulationError = null;
        runCancellation = new CancellationTokenSource();
        Controller.Resume();
        if (audioEnabled && audioModule is not null)
            _ = audioModule.InvokeVoidAsync("setEnabled", true);
        isRunning = true;
        runTask = RunLoopAsync(runCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RunLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
        var previousTimestamp = System.Diagnostics.Stopwatch.GetTimestamp();
        var frameCount = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var currentTimestamp = System.Diagnostics.Stopwatch.GetTimestamp();
                var elapsed = (currentTimestamp - previousTimestamp) /
                    (double)System.Diagnostics.Stopwatch.Frequency;
                previousTimestamp = currentTimestamp;
                await PollGamepadAsync();
                Controller.Advance(Math.Clamp(elapsed, 0, 0.25));
                if (audioEnabled && audioModule is not null)
                    await audioModule.InvokeVoidAsync("update", Controller.ThrottlePercent, speedKmh, Controller.BrakePercent);
                frameCount++;
                if (frameCount % 2 == 0)
                {
                    await InvokeAsync(async () =>
                    {
                        await MotionChanged.InvokeAsync(Controller.State);
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception exception)
        {
            Controller.Pause();
            isRunning = false;
            simulationError = $"Simulation paused: {exception.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopAsync()
    {
        Controller.Pause();
        isRunning = false;
        if (audioModule is not null)
        {
            try { await audioModule.InvokeVoidAsync("setEnabled", false); } catch (JSException) { }
        }
        var cancellation = runCancellation;
        runCancellation = null;
        cancellation?.Cancel();
        if (runTask is not null)
        {
            try { await runTask; } catch (OperationCanceledException) { }
            runTask = null;
        }
        cancellation?.Dispose();
    }

    private async Task ResetAsync()
    {
        await StopAsync();
        Controller.Reset();
        await MotionChanged.InvokeAsync(Controller.State);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await StopAsync();
        if (gamepadModule is not null)
        {
            try { await gamepadModule.DisposeAsync(); } catch (JSException) { }
        }
        if (audioModule is not null)
        {
            try { await audioModule.InvokeVoidAsync("dispose"); } catch (JSException) { }
            try { await audioModule.DisposeAsync(); } catch (JSException) { }
        }
        if (settingsModule is not null)
        {
            try { await settingsModule.DisposeAsync(); } catch (JSException) { }
        }
        if (snapshotStorageModule is not null)
        {
            try { await snapshotStorageModule.DisposeAsync(); } catch (JSException) { }
        }
    }
}
