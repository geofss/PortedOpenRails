@using OpenRails.Web.Parsing
@using OpenRails.Web.Simulation
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="route-world-view">
    <h3>Route terrain · WebGL preview</h3>
    <p class="hint">Original terrain materials, track-section geometry and loaded track-shape meshes are uploaded to WebGL. Drag to orbit and tilt, scroll or pinch to zoom.</p>
    <canvas @ref="canvas" class="route-world-canvas" aria-label="3D route terrain mesh rendered with WebGL"></canvas>
    <dl class="route-render-stats">
        <dt>Terrain tiles discovered / loaded</dt><dd>@Route.TerrainTiles.Found.Count / @Route.TerrainMeshes.Meshes.Count</dd>
        <dt>Terrain textures loaded / failed</dt><dd>@Route.TerrainTextures.Loaded.Count / @Route.TerrainTextures.Failed.Count</dd>
        <dt>Track-shape assets loaded / failed</dt><dd>@Route.TrackShapeMeshes.LoadedMeshes.Count / @Route.TrackShapeMeshes.FailedMeshes.Count</dd>
        <dt>Track-shape textures loaded / missing / failed</dt><dd>@Route.TrackShapeMeshes.Textures.Loaded.Count / @Route.TrackShapeMeshes.Textures.Missing.Count / @Route.TrackShapeMeshes.Textures.Failed.Count</dd>
        <dt>Track-shape placements</dt><dd>@Route.TrackShapePlacements.Count</dd>
        <dt>Geometry cap reached</dt><dd>@(trackGeometryTruncated ? "Yes — some geometry omitted" : "No")</dd>
        <dt>World tiles loaded / missing / failed</dt><dd>@Route.WorldScenery.Loaded.Count / @Route.WorldScenery.Missing.Count / @Route.WorldScenery.Failed.Count</dd>
        <dt>WORLD parse diagnostics</dt><dd>@Route.WorldScenery.Loaded.Sum(tile => tile.Tile.Diagnostics.Count)</dd>
        <dt>World shape meshes loaded</dt><dd>@Route.WorldScenery.Loaded.Sum(tile => tile.ShapeMeshes.Count)</dd>
        <dt>World placements discovered</dt><dd>@Route.WorldScenery.Loaded.Sum(tile => tile.Placements.Count)</dd>
        <dt>World placements with positions</dt><dd>@Route.WorldScenery.Loaded.Sum(tile => tile.Placements.Count(placement => placement.WorldPosition is not null))</dd>
        <dt>World placements with shape assets</dt><dd>@Route.WorldScenery.Loaded.Sum(tile => tile.Placements.Count(placement => placement.FileName is not null && tile.ShapeMeshes.Any(mesh => string.Equals(mesh.FileName, placement.FileName, StringComparison.OrdinalIgnoreCase))))</dd>
        <dt>World shape mesh load failures</dt><dd>@Route.WorldScenery.Loaded.Sum(tile => tile.FailedShapes.Count)</dd>
        <dt>World shape assets missing</dt><dd>@Route.WorldScenery.Loaded.Sum(tile => tile.ShapeDiscovery.Missing.Count)</dd>
        <dt>World shape assets discovered</dt><dd>@Route.WorldScenery.Loaded.Sum(tile => tile.ShapeDiscovery.Found.Count)</dd>
        <dt>World shape textures loaded / missing / failed</dt><dd>@Route.WorldScenery.Loaded.Sum(tile => tile.Textures.Loaded.Count) / @Route.WorldScenery.Loaded.Sum(tile => tile.Textures.Missing.Count) / @Route.WorldScenery.Loaded.Sum(tile => tile.Textures.Failed.Count)</dd>
        <dt>Terrain patches sent to preview</dt><dd>@Math.Min(8, Route.TerrainMeshes.Meshes.Count) tile(s), first LOD</dd>
    </dl>
    <details class="route-world-asset-diagnostics">
        <summary>Route and world scenery asset diagnostics</summary>
        <ul>
            @foreach (var tile in Route.WorldScenery.Missing)
            {
                <li>Missing WORLD tile: W@(tile.TileX) @(tile.TileZ)</li>
            }
            @foreach (var issue in Route.WorldScenery.Failed)
            {
                <li>Failed WORLD tile: @issue.Path — @issue.Reason</li>
            }
            @foreach (var issue in Route.TrackShapeMeshes.MissingMeshes)
            {
                <li>Missing track shape: @issue.FileName — @issue.Reason</li>
            }
            @foreach (var issue in Route.TrackShapeMeshes.FailedMeshes)
            {
                <li>Failed track shape: @issue.Path — @issue.Reason</li>
            }
            @foreach (var issue in Route.TrackShapeMeshes.Textures.Missing)
            {
                <li>Missing track texture: @issue.ImageName (shape @issue.ShapeIndex) — @issue.Reason</li>
            }
            @foreach (var issue in Route.TrackShapeMeshes.Textures.Failed)
            {
                <li>Failed track texture: @issue.Path — @issue.Reason</li>
            }
            @foreach (var tile in Route.WorldScenery.Loaded)
            {
                @foreach (var diagnostic in tile.Tile.Diagnostics)
                {
                    <li>WORLD parse note: @tile.Tile.SourcePath — @diagnostic</li>
                }
                @foreach (var issue in tile.ShapeDiscovery.Missing)
                {
                    <li>Missing shape: @issue.FileName — @issue.Reason</li>
                }
                @foreach (var issue in tile.FailedShapes)
                {
                    <li>Failed shape: @issue.Path — @issue.Reason</li>
                }
                @foreach (var issue in tile.Textures.Missing)
                {
                    <li>Missing world texture: @issue.ImageName (shape @issue.ShapeIndex) — @issue.Reason</li>
                }
                @foreach (var issue in tile.Textures.Failed)
                {
                    <li>Failed world texture: @issue.Path — @issue.Reason</li>
                }
            }
        </ul>
    </details>
    @if (renderError is not null)
    {
        <p class="error">@renderError</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public RouteLoadResult Route { get; set; } = default!;
    private ElementReference canvas;
    private IJSObjectReference? module;
    private string? renderError;
    private bool initialized;
    private bool hasDrawn;
    private bool trackGeometryTruncated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/route-terrain-renderer.js");
                await module.InvokeVoidAsync("initialize", canvas);
                initialized = true;
            }
            catch (Exception ex) { renderError = $"WebGL renderer initialization failed: {ex.Message}"; await InvokeAsync(StateHasChanged); }
        }
        if (initialized && module is not null && !hasDrawn)
        {
            try
            {
                var textures = new List<object>();
                var textureIndexes = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                foreach (var asset in Route.TerrainTextures.Loaded)
                {
                    var texture = asset.Texture;
                    if (texture.PixelFormat != AceTexturePixelFormat.Rgba8 || texture.MipLevels.Count == 0 || asset.Reference.SeasonFolder is not null)
                        continue;
                    if (!textureIndexes.ContainsKey(asset.Reference.Path))
                    {
                        textureIndexes.Add(asset.Reference.Path, textures.Count);
                        textures.Add(new { width = texture.Width, height = texture.Height, pixels = texture.MipLevels[0] });
                    }
                }

                var patches = new List<object>();
                foreach (var loaded in Route.TerrainMeshes.Meshes.Take(8))
                foreach (var lod in loaded.LodMeshes.Take(1))
                foreach (var patch in lod.Patches)
                {
                    var tileXOffset = loaded.Content.Reference.TileX * 2048f;
                    var tileZOffset = loaded.Content.Reference.TileZ * 2048f;
                    var materialPath = Route.TerrainTextures.Loaded.FirstOrDefault(asset =>
                        asset.Reference.TextureSlotIndex == 0 &&
                        asset.Reference.SeasonFolder is null &&
                        string.Equals(asset.Reference.ShaderName, patch.Material?.ShaderName, StringComparison.OrdinalIgnoreCase))?.Reference.Path;
                    var textureIndex = materialPath is not null && textureIndexes.TryGetValue(materialPath, out var foundIndex) ? foundIndex : -1;
                    var vertices = new float[patch.Vertices.Count * 5];
                    for (var i = 0; i < patch.Vertices.Count; i++)
                    {
                        var vertex = patch.Vertices[i];
                        var offset = i * 5;
                        vertices[offset] = vertex.Position.X + patch.PatchOrigin.X + tileXOffset;
                        vertices[offset + 1] = vertex.Position.Y + patch.PatchOrigin.Y;
                        vertices[offset + 2] = vertex.Position.Z + patch.PatchOrigin.Z + tileZOffset;
                        vertices[offset + 3] = vertex.TextureCoordinate.X;
                        vertices[offset + 4] = vertex.TextureCoordinate.Y;
                    }
                    patches.Add(new { vertices, indices = patch.Indices, textureIndex });
                }
                var trackLines = new List<float>();
                var tessellator = new TrackGeometryTessellator();
                foreach (var path in Route.TrackNetwork.VectorPaths)
                {
                    if (trackLines.Count >= 600000) break;
                    var points = tessellator.BuildPolyline(path, 20, 100000);
                    for (var i = 0; i + 1 < points.Count; i++)
                    {
                        trackLines.Add((float)points[i].X); trackLines.Add((float)points[i].Y); trackLines.Add((float)points[i].Z);
                        trackLines.Add((float)points[i + 1].X); trackLines.Add((float)points[i + 1].Y); trackLines.Add((float)points[i + 1].Z);
                    }
                }
                var shapeTextureAssets = Route.TrackShapeMeshes.Textures.Loaded
                    .Where(asset => asset.Reference.SeasonFolder is null &&
                        asset.Texture.PixelFormat == AceTexturePixelFormat.Rgba8 &&
                        asset.Texture.MipLevels.Count > 0)
                    .ToArray();
                var shapeTextures = shapeTextureAssets.Select(asset => new
                {
                    width = asset.Texture.Width,
                    height = asset.Texture.Height,
                    pixels = asset.Texture.MipLevels[0]
                }).ToArray();
                var shapeGeometry = new TrackShapeRenderGeometryBuilder()
                    .BuildTextured(Route.TrackShapePlacements, Route.TrackShapeMeshes.Textures.Loaded);
                trackGeometryTruncated = shapeGeometry.WasTruncated;
                var shapeBatches = shapeGeometry.Batches.Select(batch => new
                {
                    vertices = batch.Vertices,
                    indices = batch.Indices,
                    textureIndex = batch.TextureIndex,
                    alphaTest = batch.AlphaTest,
                    textureAddressMode = batch.TextureAddressMode,
                    zBias = batch.ZBias
                }).ToArray();
                await module.InvokeVoidAsync("drawTerrainTextured", patches, textures, trackLines.ToArray(),
                    null, shapeBatches, shapeTextures);
                hasDrawn = true;
            }
            catch (Exception ex) { hasDrawn = true; renderError = $"Terrain rendering failed: {ex.Message}"; await InvokeAsync(StateHasChanged); }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("cleanup"); } catch { }
            try { await module.DisposeAsync(); } catch { }
        }
    }
}
