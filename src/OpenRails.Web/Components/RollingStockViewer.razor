@using System.Numerics
@using OpenRails.Web.Content
@using OpenRails.Web.Parsing
@using OpenRails.Web.Simulation
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="rolling-stock-preview">
    <h4>Rolling-stock model preview</h4>
    <p class="hint">Original WagonShape geometry · ACE material textures where available · first available LOD</p>
    <canvas @ref="canvas" class="route-world-canvas" aria-label="3D preview of original rolling-stock models"></canvas>
    @if (!string.IsNullOrWhiteSpace(status))
    {
        <p class="hint">@status</p>
    }
    @if (failures.Count > 0)
    {
        <ul class="path-list">
            @foreach (var failure in failures)
            {
                <li>@failure</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public IVirtualContentStore Store { get; set; } = default!;
    [Parameter, EditorRequired] public ConsistMetadata Consist { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ConsistCarAssetReference> CarAssets { get; set; } = Array.Empty<ConsistCarAssetReference>();

    private ElementReference canvas;
    private IJSObjectReference? module;
    private string? status;
    private readonly List<string> failures = [];
    private bool initialized;
    private bool drawn;
    private string? renderKey;

    protected override void OnParametersSet()
    {
        if (Store is null || Consist is null)
            return;

        // The viewer is reused when the selected consist or route package changes.
        // Rebuild the scene only when its actual source inputs change, not on every
        // parent render.
        var nextKey = string.Join("|",
            System.Runtime.CompilerServices.RuntimeHelpers.GetHashCode(Store),
            Consist.Name,
            string.Join(";", Consist.Cars.Select(car => $"{car.Uid}:{car.Name}:{car.IsEndOfTrain}")),
            string.Join(";", CarAssets.Select(asset =>
                $"{asset.ConsistName}:{asset.Uid}:{asset.ShapeAssetPath}:{asset.ShapeFound}")));

        if (renderKey is not null && !string.Equals(renderKey, nextKey, StringComparison.Ordinal))
        {
            drawn = false;
            failures.Clear();
            status = null;
        }

        renderKey = nextKey;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/route-terrain-renderer.js");
                await module.InvokeVoidAsync("initialize", canvas);
                initialized = true;
            }
            catch (Exception exception)
            {
                status = $"WebGL preview unavailable: {exception.Message}";
                await InvokeAsync(StateHasChanged);
            }
        }

        if (!initialized || module is null || drawn)
            return;

        try
        {
            var placements = new List<TrackShapePlacement>();
            var shapeAssets = new List<TrackShapeAssetMesh>();
            var textureDiscoveries = new List<TrackShapeTextureAssetDiscovery>();
            var offset = 0f;
            var loadedCount = 0;
            var loader = new RollingStockShapeAssetLoader();
            foreach (var car in Consist.Cars.Where(car => !car.IsEndOfTrain))
            {
                var reference = CarAssets.FirstOrDefault(asset => asset.ConsistName == Consist.Name && asset.Uid == car.Uid);
                if (reference?.ShapeFound != true || reference.ShapeAssetPath is null)
                {
                    failures.Add($"{car.Name}: shape asset is unavailable.");
                    offset += Math.Max(4, reference?.Metadata?.LengthM ?? 10);
                    continue;
                }

                try
                {
                    var shapeAsset = new RollingStockShapeAssetReference(
                        reference.Metadata?.ShapeFileName ?? Path.GetFileName(reference.ShapeAssetPath),
                        reference.ShapeAssetPath);
                    var mesh = loader.Load(Store, shapeAsset);
                    var asset = new TrackShapeAssetMesh((uint)loadedCount, Path.GetFileName(reference.ShapeAssetPath), reference.ShapeAssetPath, mesh);
                    shapeAssets.Add(asset);
                    textureDiscoveries.Add(new RollingStockTextureAssetLocator().Locate(Store, reference.Folder, new[] { asset }));
                    var transform = Matrix4x4.CreateTranslation(offset, 0, 0);
                    placements.Add(new TrackShapePlacement(
                        0, (uint)loadedCount, (uint)loadedCount,
                        new TrackWorldPosition(offset, 0, 0), 0, asset, transform));
                    offset += Math.Max(4, reference.Metadata?.LengthM ?? 10);
                    loadedCount++;
                }
                catch (Exception exception) when (exception is InvalidDataException or IOException or ArgumentException)
                {
                    failures.Add($"{car.Name}: {exception.Message}");
                    offset += Math.Max(4, reference.Metadata?.LengthM ?? 10);
                }
            }

            var discoveries = new TrackShapeTextureAssetDiscovery(
                textureDiscoveries.SelectMany(discovery => discovery.Found),
                textureDiscoveries.SelectMany(discovery => discovery.Missing));
            var textures = new TrackShapeTextureAssetLoader().Load(Store, discoveries, maximumDecodedBytes: 256L * 1024 * 1024);
            var renderTextures = TrackShapeSeasonTextureSelector.Select(textures.Loaded);
            var geometry = new TrackShapeRenderGeometryBuilder().BuildTextured(placements, renderTextures);
            var shapePixels = renderTextures
                .Select(texture => new
                {
                    width = texture.Texture.Width,
                    height = texture.Texture.Height,
                    pixels = texture.Texture.MipLevels[0]
                })
                .ToArray();
            var shapeBatches = geometry.Batches.Select(batch => new
            {
                vertices = batch.Vertices,
                indices = batch.Indices,
                textureIndex = batch.TextureIndex,
                alphaTest = batch.AlphaTest,
                textureAddressMode = batch.TextureAddressMode,
                zBias = batch.ZBias
            }).ToArray();

            await module.InvokeVoidAsync("drawTerrainTextured",
                Array.Empty<object>(),
                Array.Empty<object>(),
                Array.Empty<float>(),
                null,
                shapeBatches,
                shapePixels);

            var texturedCount = geometry.Batches.Count(batch => batch.TextureIndex >= 0);
            status = $"{loadedCount} original shape(s) loaded · {texturedCount} textured material batch(es) · " +
                $"{geometry.Batches.Count:N0} total material batch(es) · {geometry.Batches.Sum(batch => batch.Vertices.Count / 5):N0} vertices · " +
                $"{geometry.Batches.Sum(batch => batch.Indices.Count):N0} indices" +
                (geometry.WasTruncated ? " · geometry limit reached" : "");
            status += $" · {textures.Loaded.Count} ACE texture(s) retained within the 256 MiB preview budget";
            if (textures.Missing.Count > 0 || textures.Failed.Count > 0)
                status += $" · {textures.Missing.Count + textures.Failed.Count} texture issue(s)";
            failures.AddRange(textures.Missing.Select(issue => $"{issue.ImageName}: {issue.Reason}"));
            failures.AddRange(textures.Failed.Select(issue => $"{issue.Path}: {issue.Reason}"));
        }
        catch (Exception exception)
        {
            status = $"Rolling-stock preview failed: {exception.Message}";
        }
        finally
        {
            drawn = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("cleanup"); } catch { }
            try { await module.DisposeAsync(); } catch { }
        }
    }
}
